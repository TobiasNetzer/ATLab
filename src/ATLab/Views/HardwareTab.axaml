<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:HardwareTabViewModel"
             x:Class="ATLab.Views.HardwareTab">
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    
        <Grid ColumnDefinitions="*, Auto, Auto, *"
              RowDefinitions="Auto, Auto, *"
              Margin="0 10"
              ColumnSpacing="10"
              RowSpacing="10">
            
            <controls:TestHardwareInterface Grid.Row="0"
                                            Grid.RowSpan="3"
                                            Grid.Column="1"/>  
            
            <controls:TestHardwareInfo Grid.Row="0"
                                       Grid.Column="2"
                                       DataContext="{Binding TestHardwareInfoViewModel}"/> 
            
            <controls:TestHardwareDiagnostics Grid.Row="1"
                                              Grid.Column="2"
                                              Grid.RowSpan="2"
                                              VerticalAlignment="Top"
                                              DataContext="{Binding TestHardwareDiagnosticsViewModel}"/>
            
        </Grid>
    </ScrollViewer>
</UserControl>
