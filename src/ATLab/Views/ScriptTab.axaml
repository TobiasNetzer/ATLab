<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.ScriptTab"
             x:DataType="vm:ScriptingTabViewModel">
    
    <Grid ColumnDefinitions="3*,2*"
          ColumnSpacing="10"
          Margin="10">

        <controls:ScriptEditor Grid.Column="0"
                               DataContext="{Binding }"
                               MinWidth="800"/>

        <controls:ScriptRunnerPanel Grid.Column="1"
                                    DataContext="{Binding ScriptRunner}"
                                    MinWidth="420"/>
    </Grid>
    
</UserControl>