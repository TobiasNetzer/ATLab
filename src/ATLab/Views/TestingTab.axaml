<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:behaviors="clr-namespace:ATLab.Behaviors"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             xmlns:services="clr-namespace:ATLab.Services"
             xmlns:pcb="clr-namespace:ATLab.Pcb.Controls;assembly=ATLab.Pcb"
             x:Class="ATLab.Views.TestingTab"
             x:DataType="vm:TestingTabViewModel">

    <Grid ColumnDefinitions="*,Auto"
          RowDefinitions="auto,auto,*,auto,auto">

        <Border Grid.Column="0" Grid.Row="0" 
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2"
                CornerRadius="10"
                Margin="10 10 10 0">

            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal"
                            Margin="5"
                            Spacing="5">

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_NewFile}"
                        Command="{Binding NewFileCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent FilePlusCorner}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_OpenFile}"
                        Command="{Binding LoadFileWithDialogCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent FolderOpen}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_SaveFile}"
                        Command="{Binding SaveFileCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Save}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_SaveFileAs}"
                        Command="{Binding SaveFileAsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent SavePen}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_CloseFile}"
                        Command="{Binding CloseFileCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent FolderX}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_AddTestStep}"
                        Command="{Binding AddTestStepCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Plus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_RemoveTestSteps}"
                        Command="{Binding RemoveTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Minus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_MoveStepUp}"
                        Command="{Binding MoveStepUpCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowUp}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_MoveStepDown}"
                        Command="{Binding MoveStepDownCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowDown}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_DuplicateTestSteps}"
                        Command="{Binding DuplicateTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent CopyPlus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_CutTestSteps}"
                        Command="{Binding CutTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Scissors}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_CopyTestSteps}"
                        Command="{Binding CopyTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Copy}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_PasteTestSteps}"
                        Command="{Binding PasteTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ClipboardPaste}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_ExecuteSingleStep}"
                        Command="{Binding StartSingleStepTestCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartSingleStepBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent CornerDownLeft}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StartModuleTest}"
                        Command="{Binding StartModuleTestCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartModuleTestBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ListVideo}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StartTestFromSelectedStep}"
                        Command="{Binding StartTestFromSelectionCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartFromStepBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ListEnd}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StartContinuousExecution}"
                        Command="{Binding StartTestRepeatCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartRepeatTestBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                    <shadui:ButtonAssist.Icon>
                        <ContentControl Content="{LucideIconContent Repeat}"/>
                    </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StartTestExecution}"
                        Command="{Binding StartTestCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartTestBusy}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Play}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource SuccessColor60}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_RequestBreakRepeat}"
                        Command="{Binding RequestBreakRepeatCommand}"
                        Width="40"
                        Height="40"
                        IsVisible="{Binding IsShowContinueButton}">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent SkipForward}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StopTestExecution}"
                        Command="{Binding CancelTestCommand}"
                        Width="40"
                        Height="40"
                        IsVisible="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Square}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ErrorColor60}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_StopTestExecution}"
                        Command="{Binding CancelTestCommand}"
                        Width="40"
                        Height="40"
                        IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RUNNING}">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Square}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_PreviousFailedStep}"
                        Command="{Binding GoToPreviousFailedStepCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowBigUpDash}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_NextFailedStep}"
                        Command="{Binding GoToNextFailedStepCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowBigDownDash}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               IsVisible="{Binding IsDevelopmentMode}"
                               Background="{DynamicResource MutedColor}"/>

                    <Button
                        Background="{Binding IsDebugMode, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_EnableDebugMode}"
                        Command="{Binding ToggleDebugModeCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        IsVisible="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Bug}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_AdvanceSingleStep}"
                        Command="{Binding RequestSingleStepContinueCommand}"
                        IsVisible="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent RedoDot}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>

                    <Button
                        Background="{Binding IsShowMeasurementPanel, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_ShowMeasurementPanel}"
                        Command="{Binding ToggleMeasurementPanelCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Search}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{Binding BoardViewer.IsVisible, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_ShowBoardView}"
                        Command="{Binding BoardViewer.ToggleVisibleCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent CircuitBoard}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{Binding IsDevelopmentMode, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_EnableDevelopmentMode}"
                        Command="{Binding ToggleDevelopmentModeCommand}"
                        IsEnabled="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <Panel>
                                <ContentControl Content="{LucideIconContent Wrench}"
                                                IsVisible="{Binding IsDevelopmentMode}"/>
                                <ContentControl Content="{LucideIconContent WrenchOff}"
                                                IsVisible="{Binding !IsDevelopmentMode}"/>
                            </Panel>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <controls:StatusPanel Grid.Column="0" Grid.Row="1"
                              ProgressValue="{Binding StatusService.Progress}"
                              StatusText="{Binding StatusService.Text}"
                              IsIndeterminateValue="{Binding StatusService.IsIndeterminate}"
                              AnimationDurationValue="{Binding StatusService.AnimationDuration}"
                              Margin="10 10 10 0"
                              IsVisible="{Binding StatusService.IsVisible}"/>

        <Grid Grid.Column="0" Grid.Row="2"
              Margin="10">
            <!-- Minimum sizes, so the splitters cannot collapse a panel by accident -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <controls:ModuleExplorer Grid.Column="0"/>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          Background="Transparent"
                          ResizeDirection="Columns"/>

            <Grid Grid.Column="2" x:Name="StepArea" RowDefinitions="*,Auto,Auto">

            <DataGrid Grid.Row="0"
                      x:Name="TestStepPresenter"
                      Classes="HorizontalScroll Compact"
                      ItemsSource="{Binding TestSteps}"
                      SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      GridLinesVisibility="All"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      BorderThickness="2"
                      BorderBrush="{DynamicResource OutlineColor}"
                      behaviors:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedSteps}"
                      IsEnabled="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}">

                <DataGrid.Styles>
                    <Style Selector="DataGridCell.StepNumberCell">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>

                    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                        <Setter Property="Fill" Value="{DynamicResource InfoColor}" />
                        <Setter Property="Opacity" Value="1" />
                    </Style>

                    <Style Selector="DataGridRow">
                        <Setter Property="Opacity"
                                Value="{ReflectionBinding DataContext.TestStep.IsIgnoreStep,
                                RelativeSource={RelativeSource Self},
                                Converter={StaticResource BoolToOpacityConverter}}" />
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{helpers:Localize Header_No}" MinWidth="50">
                        <DataGridTemplateColumn.CellStyleClasses>
                            <x:String>StepNumberCell</x:String>
                        </DataGridTemplateColumn.CellStyleClasses>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <Grid ColumnDefinitions="4,*">

                                    <Border Grid.Column="0"
                                            Background="{Binding TestStep.StepBrush}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TestStep.Number}"
                                               Margin="10 0 12 0"
                                               VerticalAlignment="Center"/>

                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{helpers:Localize Header_Name}" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <TextBlock Text="{Binding TestStep.Name}"
                                           ToolTip.Tip="{Binding TestStep.Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{helpers:Localize Header_LowerLimit}" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                            <Binding Path="TestStep.LowerLimit"/>
                                            <Binding Path="TestStep.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{helpers:Localize Header_NominalValue}" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                            <Binding Path="TestStep.NominalValue"/>
                                            <Binding Path="TestStep.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{helpers:Localize Header_UpperLimit}" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                            <Binding Path="TestStep.UpperLimit"/>
                                            <Binding Path="TestStep.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{helpers:Localize Header_MeasuredValue}" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:TestStepViewModel">
                                <TextBlock Text="{Binding Result}" 
                                           Foreground="{Binding IsPassed, Converter={StaticResource ResultBrushConverter}}"
                                           ToolTip.Tip="{Binding ResultDetails}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{helpers:Localize Header_Deviation}" Binding="{Binding Deviation}" MinWidth="110" />
                    <DataGridTemplateColumn Header="{helpers:Localize Header_Result}" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="15" Height="15"
                                       Source="{Binding IsPassed, Converter={StaticResource PassFailConverter}}"
                                       ToolTip.Tip="{ReflectionBinding ResultDetails}"
                                       IsVisible="{Binding IsExecuted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu IsEnabled="{Binding IsDevelopmentMode}">
                        <MenuItem Header="{helpers:Localize Menu_Add}" Command="{Binding AddTestStepCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_Remove}" Command="{Binding RemoveTestStepsCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_MoveUp}" Command="{Binding MoveStepUpCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_MoveDown}" Command="{Binding MoveStepDownCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_Duplicate}" Command="{Binding DuplicateTestStepsCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_Cut}" Command="{Binding CutTestStepsCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_Copy}" Command="{Binding CopyTestStepsCommand}"/>
                        <MenuItem Header="{helpers:Localize Menu_Paste}" Command="{Binding PasteTestStepsCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.KeyBindings>
                    <KeyBinding Gesture="Insert"
                                Command="{Binding AddTestStepCommand}" />
                    <KeyBinding Gesture="Delete"
                                Command="{Binding RemoveTestStepsCommand}" />
                    <KeyBinding Gesture="Ctrl+C"
                                Command="{Binding CopyTestStepsCommand}" />
                    <KeyBinding Gesture="Ctrl+X"
                                Command="{Binding CutTestStepsCommand}" />
                    <KeyBinding Gesture="Ctrl+V"
                                Command="{Binding PasteTestStepsCommand}" />
                    <KeyBinding Gesture="Ctrl+D"
                                Command="{Binding DuplicateTestStepsCommand}" />
                </DataGrid.KeyBindings>

            </DataGrid>

            <GridSplitter Grid.Row="1"
                          x:Name="BoardSplitter"
                          Height="10"
                          Background="Transparent"
                          ResizeDirection="Rows"
                          IsVisible="{Binding BoardViewer.IsVisible}"/>

            <!-- Board view: where the selected (or running) step connects to the board -->
            <Border Grid.Row="2"
                    x:Name="BoardPanel"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource OutlineColor}"
                    CornerRadius="10"
                    ClipToBounds="True"
                    IsVisible="{Binding BoardViewer.IsVisible}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6,8,4">
                        <TextBlock Text="{Binding BoardViewer.Title}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Classes.BoardFailed="{Binding BoardViewer.IsTitleFailed}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.BoardFailed">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <RadioButton GroupName="BoardSide" Content="{helpers:Localize Board_ViewTop}"
                                         IsChecked="{Binding BoardViewer.IsTopView}" VerticalAlignment="Center"/>
                            <RadioButton GroupName="BoardSide" Content="{helpers:Localize Board_ViewBottom}"
                                         IsChecked="{Binding BoardViewer.IsBottomView}" VerticalAlignment="Center"
                                         ToolTip.Tip="{helpers:Localize ToolTip_BoardViewBottom}"/>
                            <Button Background="{Binding BoardViewer.IsCoverageMode, Converter={StaticResource ButtonEnabledConverter}}"
                                    Content="{helpers:Localize Board_Coverage}"
                                    Command="{Binding BoardViewer.ToggleCoverageCommand}"
                                    ToolTip.Tip="{helpers:Localize ToolTip_BoardCoverage}"
                                    Height="30" Padding="10,0"/>
                            <Button Background="{Binding BoardViewer.IsHighlightZones, Converter={StaticResource ButtonEnabledConverter}}"
                                    Content="{helpers:Localize Board_Zones}"
                                    Command="{Binding BoardViewer.ToggleHighlightZonesCommand}"
                                    ToolTip.Tip="{helpers:Localize ToolTip_BoardZones}"
                                    Height="30" Padding="10,0"/>
                            <Button Classes="Icon" Width="30" Height="30"
                                    Background="{DynamicResource ButtonBackground}"
                                    Click="OnBoardFitClicked"
                                    ToolTip.Tip="{helpers:Localize ToolTip_BoardFit}">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Maximize, 16}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            <Button Classes="Icon" Width="30" Height="30"
                                    Background="{DynamicResource ButtonBackground}"
                                    ToolTip.Tip="{helpers:Localize ToolTip_BoardLayers}">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Layers, 16}"/>
                                </shadui:ButtonAssist.Icon>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="6" MinWidth="220">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="Outline" Height="28" Padding="10,0"
                                                        Content="{helpers:Localize Board_AllLayers}"
                                                        Command="{Binding BoardViewer.ShowAllLayersCommand}" CommandParameter="{x:True}"/>
                                                <Button Classes="Outline" Height="28" Padding="10,0"
                                                        Content="{helpers:Localize Board_NoLayers}"
                                                        Command="{Binding BoardViewer.ShowAllLayersCommand}" CommandParameter="{x:False}"/>
                                                <Button Classes="Outline" Height="28" Padding="10,0"
                                                        Content="{helpers:Localize Button_DefaultLayerColors}"
                                                        Command="{Binding BoardViewer.ResetLayerColorsCommand}"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="420">
                                                <ItemsControl ItemsSource="{Binding BoardViewer.LayerOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- The swatch opens the color picker -->
                                                        <DataTemplate DataType="vm:BoardLayerOption">
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                                                <StackPanel Orientation="Horizontal" Width="64" VerticalAlignment="Center">
                                                                    <ColorPicker Color="{Binding Color, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" CornerRadius="6"
                                                                                 ToolTip.Tip="{helpers:Localize ToolTip_BoardRoleColor}">
                                                                        <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Brush}"/>
                                                                    </ColorPicker>
                                                                </StackPanel>
                                                                <CheckBox IsChecked="{Binding IsVisible}">
                                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                </CheckBox>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Roles shown on the board: click the name to show or hide it, the color picker beside it to choose
                         its color. One line; a narrow window scrolls it sideways -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="10,0,10,0">
                    <!-- The bottom margin is the room of the scrollbar, which would otherwise lie on the buttons -->
                    <ItemsControl ItemsSource="{Binding BoardViewer.RoleOptions}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BoardRoleOption">
                                <!-- Outer radius = inner radius 6 + gap 2 + border 1, so the corners run in parallel -->
                                <Border CornerRadius="9" BorderThickness="1" Padding="2"
                                        BorderBrush="{DynamicResource OutlineColor}"
                                        Background="{DynamicResource ButtonBackground}"
                                        Classes.RoleHidden="{Binding !IsShown}">
                                    <Border.Styles>
                                        <Style Selector="Border.RoleHidden">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Style>
                                    </Border.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- The same color picker as the accent color of a step, without alpha -->
                                        <ColorPicker Color="{Binding Color, Mode=TwoWay}"
                                                     CornerRadius="6"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaVisible="False"
                                                     VerticalAlignment="Center"
                                                     ToolTip.Tip="{helpers:Localize ToolTip_BoardRoleColor}">
                                            <!-- Only a dot of the color on the button, the chip stays small -->
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}"/>
                                        </ColorPicker>
                                        <Button Command="{Binding ToggleCommand}"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Height="32" MinHeight="0" Padding="8,0,10,0"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="{helpers:Localize ToolTip_BoardRoleToggle}">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{helpers:Localize Board_RoleDefaultColor}"
                                                              Command="{Binding ResetColorCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- What the step connects: role, adapter resource and net in the color of the role. One line that
                         is always there, also when empty, so the board keeps its size from step to step; a narrow
                         window scrolls it sideways -->
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="10,0,10,0">
                    <ItemsControl ItemsSource="{Binding BoardViewer.Legend}"
                                  MinHeight="20"
                                  Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="services:BoardLegendItem">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Classes="Small" VerticalAlignment="Center">
                                        <Run Text="{Binding Role}" FontWeight="Bold"/>
                                        <Run Text="{Binding Resource}"/>
                                    </TextBlock>
                                    <TextBlock Classes="Small" Text="{Binding Net}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" IsVisible="{Binding HasNet}"/>
                                    <TextBlock Classes="Small" Text="{helpers:Localize Board_NoNetAssigned}"
                                               Foreground="{DynamicResource MutedColor}"
                                               VerticalAlignment="Center" IsVisible="{Binding !HasNet}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- No board, loading, error, or a board file that changed since the nets were assigned -->
                    <Border Grid.Row="3"
                            IsVisible="{Binding BoardViewer.HasNotice}"
                            Background="{DynamicResource WarningColor10}"
                            Padding="10,6"
                            Margin="8,0,8,6"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding BoardViewer.Notice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="Outline" Height="28" Padding="10,0"
                                    Content="{helpers:Localize Board_AcceptChange}"
                                    ToolTip.Tip="{helpers:Localize ToolTip_BoardAcceptChange}"
                                    Command="{Binding BoardViewer.AcceptBoardChangeCommand}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="BoardViewer.IsBoardChanged"/>
                                        <Binding Path="IsDevelopmentMode"/>
                                    </MultiBinding>
                                </Button.IsVisible>
                            </Button>
                        </Grid>
                    </Border>

                    <pcb:BoardView Grid.Row="4"
                                   x:Name="BoardView"
                                   MinHeight="120"
                                   Board="{Binding BoardViewer.Board}"
                                   ViewSide="{Binding BoardViewer.ViewSide}"
                                   Markers="{Binding BoardViewer.Markers}"
                                   NetHighlights="{Binding BoardViewer.NetHighlights}"
                                   PadHighlights="{Binding BoardViewer.PadHighlights}"
                                   FootprintHighlights="{Binding BoardViewer.FootprintHighlights}"
                                   VisibleLayers="{Binding BoardViewer.VisibleLayers}"
                                   LayerColors="{Binding BoardViewer.LayerColors}"
                                   IsZoneHighlightEnabled="{Binding BoardViewer.IsHighlightZones}"
                                   HintKey="Board_HintViewer"
                                   CornerRadius="0,0,8,8"
                                   IsVisible="{Binding BoardViewer.ShowBoard}"/>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="0" Grid.Row="3"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                CornerRadius="10"
                Margin="10 0 10 10"
                IsVisible="{Binding IsShowMeasurementPanel}">


            <controls:MeasurementPanel
                LowerLimit="{Binding SelectedStep?.TestStep.LowerLimit, TargetNullValue=0}"
                UpperLimit="{Binding SelectedStep?.TestStep.UpperLimit, TargetNullValue=0}"
                MeasuredValue="{Binding SelectedStep?.ResultNoFormatting}"
                Unit="{Binding SelectedStep?.TestStep.Unit}"
                Valid="{Binding SelectedStep?.IsPassed, TargetNullValue=False}"/>

        </Border>

        <Border Grid.Column="0" Grid.Row="4"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                CornerRadius="10"
                Margin="10 0 10 10">

            <Grid ColumnDefinitions="*,*,*,*,*"
                  RowDefinitions="Auto,10,*"
                  Margin="10 10 10 10">

            <ProgressBar Grid.Column="0"
                         Grid.ColumnSpan="5"
                         Grid.Row="0" 
                         Minimum="0"
                         Maximum="100"
                         Height="40"
                         CornerRadius="5"
                         Value="{Binding TestProgress}"
                         Background="{DynamicResource OutlineColor}"
                         Foreground="{Binding TestStatus, Converter={StaticResource TestStatusToBrushConverter}}">

                <ProgressBar.Styles>
                    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </ProgressBar.Styles>

                <ProgressBar.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Value"
                                          Duration="{Binding AnimationDuration}">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </ProgressBar.Transitions>

            </ProgressBar>

            <StackPanel Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RUNNING}">
                <TextBlock Text="{helpers:Localize Status_RunningTest}"
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text=": "
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text="{Binding SelectedModule?.Module.Name, FallbackValue=''}"
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text=" · "
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text="{Binding SelectedStep?.TestStep.Number, FallbackValue=''}"
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text=" / "
                           FontWeight="Bold"
                           FontSize="24"/>
                <TextBlock Text="{Binding TestSteps.Count}"
                           FontWeight="Bold"
                           FontSize="24"/>
            </StackPanel>

            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="{helpers:Localize Status_TestPassed}" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PASSED}"/>

            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="{helpers:Localize Status_TestFailed}" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FAILED}"/>

            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="{helpers:Localize Status_TestCanceled}" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CANCELED}"/>

            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="{helpers:Localize Status_TestExecutionFailed}" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EXECUTION_ERROR}"/>

            <Grid Grid.Column="0"
                  Grid.ColumnSpan="5"
                  Grid.Row="2"
                  ColumnSpacing="10"
                  ClipToBounds="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid.Styles>
                    <Style Selector="Border.error">
                        <Setter Property="Background" Value="{DynamicResource ErrorColor}"/>
                    </Style>
                    <Style Selector="StackPanel.error TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                    </Style>
                </Grid.Styles>

                <StackPanel Grid.Column="0"
                            Spacing="2">
                    <TextBlock Classes="Small" Text="{helpers:Localize Label_TestDuration}"/>
                    <TextBlock Classes="Small" Text="{Binding TestDuration}"/>
                </StackPanel>

                <Separator Grid.Column="1"
                           Width="2"
                           Height="40"
                           Margin="10 0 10 0"
                           CornerRadius="1"
                           Background="{DynamicResource MutedColor}"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">

                    <Panel>
                        <Border Classes.error="{Binding NumberFailedSteps}"
                                CornerRadius="5"
                                Margin="-6 -2"
                                Opacity="0.15"/>

                        <StackPanel Spacing="2"
                                    Classes.error="{Binding NumberFailedSteps}">
                            <TextBlock Classes="Small" Text="{helpers:Localize Label_FailedSteps}"/>
                            <TextBlock Classes="Small" Text="{Binding NumberFailedSteps}"/>
                        </StackPanel>
                    </Panel>

                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding IsShowTotalFailedSteps}">

                        <Separator Width="2"
                                   Height="40"
                                   Margin="20 0 20 0"
                                   CornerRadius="1"
                                   Background="{DynamicResource MutedColor}"/>

                        <Panel>
                            <Border Classes.error="{Binding TotalFailedSteps}"
                                    CornerRadius="5"
                                    Margin="-6 -2"
                                    Opacity="0.15"/>

                            <StackPanel Spacing="2"
                                        Classes.error="{Binding TotalFailedSteps}">
                                <TextBlock Classes="Small" Text="{helpers:Localize Label_TotalFailedSteps}"/>
                                <TextBlock Classes="Small" Text="{Binding TotalFailedSteps}"/>
                            </StackPanel>
                        </Panel>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Column="3"
                           Width="2"
                           Height="40"
                           Margin="10 0 10 0"
                           CornerRadius="1"
                           Background="{DynamicResource MutedColor}"/>

                <StackPanel Grid.Column="4"
                            Spacing="2">
                    <TextBlock Classes="Small" Text="{helpers:Localize Label_PassedTests}"/>
                    <TextBlock Classes="Small">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1} ({2} %)">
                                <Binding Path="NumberPassedTests"/>
                                <Binding Path="NumberRunTests"/>
                                <Binding Path="PassedPercentage"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <Separator Grid.Column="5"
                           Width="2"
                           Height="40"
                           Margin="10 0 10 0"
                           CornerRadius="1"
                           Background="{DynamicResource MutedColor}"/>

                <StackPanel Grid.Column="6"
                            Spacing="2">
                    <TextBlock Classes="Small" Text="{helpers:Localize Label_Operator}"/>
                    <TextBlock Classes="Small" Text="{Binding User}"/>
                </StackPanel>

                <Separator Grid.Column="7"
                           Width="2"
                           Height="40"
                           Margin="10 0 10 0"
                           CornerRadius="1"
                           Background="{DynamicResource MutedColor}"/>

                <StackPanel Grid.Column="8"
                            Spacing="2">
                    <ToolTip.Tip>
                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="2">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{helpers:Localize Label_DeviceName}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceUnderTestInfo.DeviceName}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{helpers:Localize Label_Revision}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceUnderTestInfo.Revision}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{helpers:Localize Label_Variant}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceUnderTestInfo.Variant}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{helpers:Localize Label_PartNumber}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceUnderTestInfo.PartNumber}"/>
                        </Grid>
                    </ToolTip.Tip>
                    <TextBlock Classes="Small" Text="{helpers:Localize Header_DeviceUnderTest}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="Small" Text="{Binding DeviceUnderTestSummary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Separator Grid.Column="9"
                           Width="2"
                           Height="40"
                           Margin="10 0 10 0"
                           CornerRadius="1"
                           Background="{DynamicResource MutedColor}"/>

                <StackPanel Grid.Column="10"
                            Spacing="2"
                            ToolTip.Tip="{Binding SerialNumber}">
                    <TextBlock Classes="Small" Text="{helpers:Localize Label_SerialNumber}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="Small" Text="{Binding SerialNumber}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

            </Grid>

        </Grid>

        </Border>

        <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.RowSpan="5"
                      Margin="0 10 0 10"
                      IsVisible="{Binding IsDevelopmentMode}">
            <StackPanel HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0 0 10 0">

                <StackPanel.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="TestStatus" Converter="{StaticResource InvertedEnumToBoolConverter}" ConverterParameter="RUNNING"/>
                        <Binding Path="SelectedStep" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                    </MultiBinding>
                </StackPanel.IsEnabled>

                <controls:TestStepConfigurator
                    x:Name="StepConfigurator"
                    DataContext="{Binding WorkspaceEditor.TestStepConfigurator}"/>

                <controls:ScriptSelector
                    ScriptSelectorVm="{Binding WorkspaceEditor.ScriptSelector}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SCRIPT, TargetNullValue=False}"/>

                <controls:CommandEditor
                    CommandEditorVm="{Binding WorkspaceEditor.CommandEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=COMMAND, TargetNullValue=False}"/>

                <controls:ExternalProgramEditor
                    ExternalProgramEditorVm="{Binding WorkspaceEditor.ExternalProgramEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EXTERNAL_PROGRAM, TargetNullValue=False}"/>

                <controls:ExpressionEditor
                    ExpressionEditorVm="{Binding WorkspaceEditor.ExpressionEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EXPRESSION, TargetNullValue=False}"/>

                <controls:FilePathEditor
                    FilePathEditorVm="{Binding WorkspaceEditor.FilePathEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FILE, TargetNullValue=False}"/>

                <controls:BoundaryScanStepEditor
                    BoundaryScanStepEditorVm="{Binding WorkspaceEditor.BoundaryScanStepEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BOUNDARY_SCAN, TargetNullValue=False}"/>

                <controls:BoundaryScanBusStepEditor
                    BoundaryScanBusStepEditorVm="{Binding WorkspaceEditor.BoundaryScanBusStepEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BOUNDARY_SCAN_BUS, TargetNullValue=False}"/>

                <controls:TestInterfaceCommunication
                    TestInterfaceCommunicationVm="{Binding WorkspaceEditor.TestInterfaceCommunication}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=INTERFACE, TargetNullValue=False}"/>

                <controls:ResponseMaskEditor
                    ResponseMaskEditorVm="{Binding WorkspaceEditor.ResponseMaskEditor}"
                    IsVisible="{Binding SelectedStep?.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='SCRIPT, COMMAND, FILE, INTERFACE, USER_INPUT, EXTERNAL_PROGRAM, BOUNDARY_SCAN_BUS', TargetNullValue=False}"/>

                <controls:MeasSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.MeasChannelViewModel}" />

                <controls:StimSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.StimChannelViewModel}"
                    GridColumns="2" />

                <controls:ExtStimSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.ExtStimChannelViewModel}"
                    GridColumns="2" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>