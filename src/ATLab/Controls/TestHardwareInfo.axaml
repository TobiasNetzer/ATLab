<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.TestHardwareInfo"
             x:DataType="vm:TestHardwareInfoViewModel"
             Width="300">
    
    <Grid RowDefinitions="Auto,*">
            
        <Border Grid.Row="0"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            <TextBlock Text="{helpers:Localize Header_TestHardwareInfo}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
            
        <Border Grid.Row="1"
                CornerRadius="0 0 15 15"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2">
                    
            <StackPanel Margin="10"
                        Spacing="10"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch">

                <StackPanel Spacing="5">
                    <TextBlock Text="{helpers:Localize Header_ConnectedHardware}"
                               Classes="Small"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareDeviceName}"/>
                        <TextBlock Text="{Binding DeviceName}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareSerialNumber}"/>
                        <TextBlock Text="{Binding SerialNumber}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareFirmware}"/>
                        <TextBlock Text="{Binding FirmwareVersion}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareBuildDate}"/>
                        <TextBlock Text="{Binding BuildDate}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareBuildTime}"/>
                        <TextBlock Text="{Binding BuildTime}"/>
                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="{helpers:Localize Header_AvailableRelayChannels}"
                               Classes="Small"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareMatrixChannels}"/>
                        <TextBlock Text="{Binding MeasChannelCount}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareStimulationChannels}"/>
                        <TextBlock Text="{Binding StimChannelCount}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareExternalStimulationChannels}"/>
                        <TextBlock Text="{Binding ExtStimChannelCount}"/>
                    </StackPanel>
                </StackPanel>
                
                <Border BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="{helpers:Localize Header_AvailableInterfaces}"
                               Classes="Small"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareIsolatedI2C}"/>
                        <TextBlock Text="{Binding InterfaceAvailableI2C}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareIsolatedUART}"/>
                        <TextBlock Text="{Binding InterfaceAvailableUART}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{helpers:Localize Label_TestHardwareIsolatedRS485}"/>
                        <TextBlock Text="{Binding InterfaceAvailableRS485}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>