<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:rendering="clr-namespace:ATLab.Pcb.Rendering;assembly=ATLab.Pcb"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.ProjectSettingsEditor"
             x:DataType="vm:ProjectSettingsViewModel"
             Width="780">

    
    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            
            <TextBlock Text="{helpers:Localize Header_ProjectSettings}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border Grid.Row="1"
            CornerRadius="0 0 15 15"
            BorderThickness="2"
            BorderBrush="{DynamicResource OutlineColor}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="10">
                    
                    <StackPanel Spacing="10"
                                Width="370">
                        
                        <Border BorderBrush="{DynamicResource OutlineColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10">

                            <StackPanel Spacing="10">
                                <TextBlock Text="{helpers:Localize Header_TestExecutionSettings}"
                                           HorizontalAlignment="Center"
                                           Classes="Large"
                                           Margin="0 0 0 10"/>

                                <CheckBox Content="{helpers:Localize Label_RequestSerialNumber}"
                                          IsChecked="{Binding Settings.IsUseSerialNumber, Mode=TwoWay}"/>

                                <CheckBox Content="{helpers:Localize Label_SaveTestResult}"
                                          IsChecked="{Binding Settings.IsSaveTestResult, Mode=TwoWay}"
                                          IsEnabled="{Binding Settings.IsUseSerialNumber}"/>
                                
                                <RadioButton Content="{helpers:Localize Label_Always}"
                                             Margin="30 0 0 0"
                                             IsChecked="{Binding Settings.SaveTestResultOptions, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ALWAYS}"
                                             IsEnabled="{Binding CanSaveTestResult}"/>

                                <RadioButton Content="{helpers:Localize Label_PassedOnly}"
                                             Margin="30 0 0 0"
                                             IsChecked="{Binding Settings.SaveTestResultOptions, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ONLY_WHEN_PASSED}"
                                             IsEnabled="{Binding CanSaveTestResult}"/>
                                
                                <CheckBox Content="{helpers:Localize Label_SortResultsByVerdict}"
                                          IsChecked="{Binding Settings.IsSortResultsByVerdict}"
                                          IsEnabled="{Binding CanSaveTestResult}"/>

                                <CheckBox Content="{helpers:Localize Label_ExportTestDataCsv}"
                                          IsChecked="{Binding Settings.IsExportCsv}"
                                          IsEnabled="{Binding CanSaveTestResult}"/>

                                <DockPanel Margin="30 0 0 0"
                                           IsVisible="{Binding Settings.IsExportCsv}"
                                           IsEnabled="{Binding CanSaveTestResult}">

                                    <Button
                                        Background="{DynamicResource ButtonBackground}"
                                        Classes="Icon"
                                        Command="{Binding SelectCsvOutputPathCommand}"
                                        ToolTip.Tip="{helpers:Localize ToolTip_SelectCsvOutputPath}"
                                        Width="35"
                                        Height="35"
                                        Margin="5 0 0 0"
                                        DockPanel.Dock="Right">
                                        <shadui:ButtonAssist.Icon>
                                            <ContentControl Content="{LucideIconContent Ellipsis}"/>
                                        </shadui:ButtonAssist.Icon>
                                    </Button>

                                    <TextBox
                                        PlaceholderText="{helpers:Localize Watermark_OutputFolder}"
                                        Text="{Binding Settings.CsvOutputPath, UpdateSourceTrigger=LostFocus}"/>

                                </DockPanel>

                                <CheckBox Content="{helpers:Localize Label_ExportTestDataJson}"
                                          IsChecked="{Binding Settings.IsExportJson}"
                                          IsEnabled="{Binding CanSaveTestResult}"/>

                                <DockPanel Margin="30 0 0 0"
                                           IsVisible="{Binding Settings.IsExportJson}"
                                           IsEnabled="{Binding CanSaveTestResult}">

                                    <Button
                                        Background="{DynamicResource ButtonBackground}"
                                        Classes="Icon"
                                        Command="{Binding SelectJsonOutputPathCommand}"
                                        ToolTip.Tip="{helpers:Localize ToolTip_SelectJsonOutputPath}"
                                        Width="35"
                                        Height="35"
                                        Margin="5 0 0 0"
                                        DockPanel.Dock="Right">
                                        <shadui:ButtonAssist.Icon>
                                            <ContentControl Content="{LucideIconContent Ellipsis}"/>
                                        </shadui:ButtonAssist.Icon>
                                    </Button>

                                    <TextBox
                                        PlaceholderText="{helpers:Localize Watermark_OutputFolder}"
                                        Text="{Binding Settings.JsonOutputPath, UpdateSourceTrigger=LostFocus}"/>

                                </DockPanel>

                                <CheckBox Content="{helpers:Localize Label_ExportTestReportPdf}"
                                          IsChecked="{Binding Settings.IsExportPdf}"
                                          IsEnabled="{Binding CanSaveTestResult}"/>

                                <DockPanel Margin="30 0 0 0"
                                           IsVisible="{Binding Settings.IsExportPdf}"
                                           IsEnabled="{Binding CanSaveTestResult}">

                                    <Button
                                        Background="{DynamicResource ButtonBackground}"
                                        Classes="Icon"
                                        Command="{Binding SelectPdfOutputPathCommand}"
                                        ToolTip.Tip="{helpers:Localize ToolTip_SelectPdfOutputPath}"
                                        Width="35"
                                        Height="35"
                                        Margin="5 0 0 0"
                                        DockPanel.Dock="Right">
                                        <shadui:ButtonAssist.Icon>
                                            <ContentControl Content="{LucideIconContent Ellipsis}"/>
                                        </shadui:ButtonAssist.Icon>
                                    </Button>

                                    <TextBox
                                        PlaceholderText="{helpers:Localize Watermark_OutputFolder}"
                                        Text="{Binding Settings.PdfOutputPath, UpdateSourceTrigger=LostFocus}"/>

                                </DockPanel>

                                <!-- Failed steps drawn on the KiCad board of the project, with the chosen layers. The button on a
                                     line of its own, so a long label (German) does not run into the next panel -->
                                <StackPanel Spacing="6" Margin="30 0 0 0"
                                            IsVisible="{Binding Settings.IsExportPdf}">
                                    <!-- The check box gives its text any width; the limit (room left in the column after indent and box) lets
                                         a long label wrap -->
                                    <CheckBox IsChecked="{Binding Settings.IsIncludeBoardViewInReport}"
                                              IsEnabled="{Binding CanSaveTestResult}"
                                              ToolTip.Tip="{helpers:Localize ToolTip_IncludeBoardViewInReport}">
                                        <TextBlock Text="{helpers:Localize Label_IncludeBoardViewInReport}"
                                                   TextWrapping="Wrap" MaxWidth="260"/>
                                    </CheckBox>
                                    <Button Classes="Outline" Height="28" Padding="10,0" Margin="28 0 0 0"
                                            HorizontalAlignment="Left"
                                            Content="{helpers:Localize Button_ReportBoardLayers}"
                                            ToolTip.Tip="{helpers:Localize ToolTip_ReportBoardLayers}"
                                            VerticalAlignment="Center">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="Settings.IsIncludeBoardViewInReport"/>
                                                <Binding Path="CanSaveTestResult"/>
                                                <Binding Path="ReportLayers.HasOptions"/>
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Spacing="6" MinWidth="220">
                                                    <!-- Side of the pictures: automatic per step, or always the top or the bottom -->
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{helpers:Localize Label_ReportBoardSide}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <RadioButton GroupName="ReportBoardSide" Content="{helpers:Localize ReportSide_Automatic}"
                                                                     IsChecked="{Binding IsReportSideAutomatic}"
                                                                     ToolTip.Tip="{helpers:Localize ToolTip_ReportSideAutomatic}"/>
                                                        <RadioButton GroupName="ReportBoardSide" Content="{helpers:Localize ReportSide_Top}"
                                                                     IsChecked="{Binding IsReportSideTop}"/>
                                                        <RadioButton GroupName="ReportBoardSide" Content="{helpers:Localize ReportSide_Bottom}"
                                                                     IsChecked="{Binding IsReportSideBottom}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{helpers:Localize Header_ReportBoardLayers}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{helpers:Localize Text_ReportBoardLayers}" Classes="Small"
                                                               TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left"
                                                               Foreground="{DynamicResource MutedColor}"/>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="6" MaxWidth="380" HorizontalAlignment="Left">
                                                        <Button Classes="Outline" Height="28" Padding="10,0"
                                                                Content="{helpers:Localize Board_AllLayers}"
                                                                Command="{Binding ReportLayers.ShowAllCommand}" CommandParameter="all"/>
                                                        <Button Classes="Outline" Height="28" Padding="10,0"
                                                                Content="{helpers:Localize Board_NoLayers}"
                                                                Command="{Binding ReportLayers.ShowAllCommand}" CommandParameter="-"/>
                                                        <Button Classes="Outline" Height="28" Padding="10,0"
                                                                Content="{helpers:Localize Button_DefaultLayerStyle}"
                                                                Command="{Binding ReportLayers.ResetStyleCommand}"/>
                                                        <Button Classes="Outline" Height="28" Padding="10,0"
                                                                Content="{helpers:Localize Button_DefaultLayerOrder}"
                                                                IsEnabled="{Binding ReportLayers.HasCustomOrder}"
                                                                Command="{Binding ReportLayers.ResetOrderCommand}"/>
                                                        <Button Classes="Outline" Height="28" Padding="10,0" Content="{helpers:Localize Button_SaveLayersAsDefault}"
                                                                ToolTip.Tip="{helpers:Localize ToolTip_SaveLayersAsDefault}"
                                                                Command="{Binding ReportLayers.SaveAsDefaultCommand}"/>
                                                        <Button Classes="Outline" Height="28" Padding="10,0" Content="{helpers:Localize Button_LoadLayersDefault}"
                                                                ToolTip.Tip="{helpers:Localize ToolTip_LoadLayersDefault}"
                                                                Command="{Binding ReportLayers.LoadDefaultCommand}"/>
                                                    </WrapPanel>
                                                    <!-- The columns line up with the rows below: order, color, top view, bottom view, name, opacity -->
                                                    <StackPanel Grid.IsSharedSizeScope="True" Spacing="2">
                                                        <Grid ColumnSpacing="10" Margin="0,0,18,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerOrder"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerColor"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerViews"/>
                                                                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerName"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="40"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding ReportLayers.Views}">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="rendering:ReportLayerView">
                                                                        <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding ToolTip}" Classes="Small" FontWeight="SemiBold"
                                                                                   Width="{x:Static rendering:ReportLayerColumns.Width}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                        <ScrollViewer MaxHeight="420">
                                                            <!-- The right margin is the room of the scrollbar -->
                                                            <ItemsControl ItemsSource="{Binding ReportLayers.Options}" Margin="0,0,18,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <!-- A layer: drawn in the top and the bottom view or not, its color and opacity -->
                                                                    <DataTemplate DataType="rendering:ReportLayerOption">
                                                                        <Grid ColumnSpacing="10" Margin="0,1">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerOrder"/>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerColor"/>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerViews"/>
                                                                                                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LayerName"/>
                                                                                <ColumnDefinition Width="120"/>
                                                                                <ColumnDefinition Width="40"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Order: the top row is drawn on top -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                                <Button Classes="Icon" Width="22" Height="22" Padding="0"
                                                                                        Background="Transparent"
                                                                                        ToolTip.Tip="{helpers:Localize ToolTip_LayerUp}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:ProjectSettingsViewModel)DataContext).ReportLayers.MoveUpCommand}"
                                                                                        CommandParameter="{Binding}">
                                                                                    <shadui:ButtonAssist.Icon>
                                                                                        <ContentControl Content="{LucideIconContent ChevronUp, 14}"/>
                                                                                    </shadui:ButtonAssist.Icon>
                                                                                </Button>
                                                                                <Button Classes="Icon" Width="22" Height="22" Padding="0"
                                                                                        Background="Transparent"
                                                                                        ToolTip.Tip="{helpers:Localize ToolTip_LayerDown}"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:ProjectSettingsViewModel)DataContext).ReportLayers.MoveDownCommand}"
                                                                                        CommandParameter="{Binding}">
                                                                                    <shadui:ButtonAssist.Icon>
                                                                                        <ContentControl Content="{LucideIconContent ChevronDown, 14}"/>
                                                                                    </shadui:ButtonAssist.Icon>
                                                                                </Button>
                                                                            </StackPanel>
                                                                            <!-- The swatch opens the color picker; it shows color and opacity -->
                                                                            <ColorPicker Grid.Column="1"
                                                                                         Color="{Binding Color, Mode=TwoWay}"
                                                                                         IsAlphaEnabled="False" IsAlphaVisible="False"
                                                                                         CornerRadius="6"
                                                                                         VerticalAlignment="Center"
                                                                                         ToolTip.Tip="{helpers:Localize ToolTip_BoardRoleColor}">
                                                                                <Border Width="14" Height="14" CornerRadius="3"
                                                                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineColor}"
                                                                                        Background="{Binding Brush}"/>
                                                                            </ColorPicker>
                                                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Toggles}">
                                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="rendering:ReportLayerToggle">
                                                                                        <Panel Width="{x:Static rendering:ReportLayerColumns.Width}">
                                                                                            <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="{Binding View.ToolTip}" HorizontalAlignment="Center"/>
                                                                                        </Panel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock Grid.Column="3" Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                            <Slider Grid.Column="4" Minimum="0" Maximum="100"
                                                                                    SmallChange="5" LargeChange="10"
                                                                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                                                                    Value="{Binding Opacity}"
                                                                                    IsEnabled="{Binding IsUsed}"
                                                                                    VerticalAlignment="Center"
                                                                                    ToolTip.Tip="{helpers:Localize ToolTip_ReportLayerOpacity}"/>
                                                                            <TextBlock Grid.Column="5" Text="{Binding OpacityText}"
                                                                                       Classes="Small" VerticalAlignment="Center" TextAlignment="Right"
                                                                                       IsEnabled="{Binding IsUsed}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                
                            </StackPanel>
                        </Border>
                        
                        <Border BorderBrush="{DynamicResource OutlineColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10">

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto, Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="10"
                                  HorizontalAlignment="Center">
                            
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{helpers:Localize Header_ControlDevices}"
                                           HorizontalAlignment="Center"
                                           Classes="Large"/>
                            
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                
                                    <CheckBox Content="{helpers:Localize Label_EnableControlModule}"
                                              IsChecked="{Binding Settings.IsControlModuleEnabled}"/>
                                
                                    <Image Source="avares://ATLab/Assets/ControlModule.png"
                                           Height="60"/>
                                
                                </StackPanel>
                            
                            </Grid>
                        </Border>
                        
                    </StackPanel>
                    
                    <StackPanel Spacing="10"
                                Width="370">
                        
                        <Border BorderBrush="{DynamicResource OutlineColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto, Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="10"
                                  HorizontalAlignment="Center">
                                
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{helpers:Localize Header_SerialNumberValidation}"
                                           HorizontalAlignment="Center"
                                           Classes="Large"/>
                                
                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Content="{helpers:Localize Label_EnableSerialNumberValidation}"
                                          IsChecked="{Binding Settings.IsEnableSerialNumberValidation}"/>
                                
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_Length}"
                                           VerticalAlignment="Center"/>
                            
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Width="150"
                                         Text="{Binding SerialNumberValidationLengthString}"/>
                                
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_StartsWith}"
                                           VerticalAlignment="Center"/>
                            
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Width="150"
                                         Text="{Binding Settings.SerialNumberValidationStartsWith}"/>
                                
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_EndsWith}"
                                           VerticalAlignment="Center"/>
                            
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         Width="150"
                                         Text="{Binding Settings.SerialNumberValidationEndsWith}"/>
                            
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_Contains}"
                                           VerticalAlignment="Center"/>
                            
                                <TextBox Grid.Row="5"
                                         Grid.Column="1"
                                         Width="150"
                                         Text="{Binding Settings.SerialNumberValidationContains}"/>
                            
                            </Grid>
                        </Border>
                        
                        <Border BorderBrush="{DynamicResource OutlineColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10">

                            <Grid RowDefinitions="Auto,Auto,Auto, Auto"
                                  ColumnDefinitions="Auto, Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="10"
                                  HorizontalAlignment="Center">
                                
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{helpers:Localize Header_GeneralSettings}"
                                           HorizontalAlignment="Center"
                                           Classes="Large"
                                           Margin="0 0 0 10"/>
                                
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_DefaultTolerance}"
                                           VerticalAlignment="Center"/>

                                <NumericUpDown Grid.Row="1"
                                               Grid.Column="1"
                                               Value="{Binding ToleranceString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Minimum="0"
                                               Maximum="100"
                                               Width="150"/>
                                
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_DisplayedDecimalPlaces}"
                                           VerticalAlignment="Center"/>

                                <NumericUpDown Grid.Row="2"
                                               Grid.Column="1"
                                               Value="{Binding DisplayedDecimalPlacesString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Minimum="0"
                                               Maximum="10"
                                               Increment="1"
                                               Width="150"/>
                                
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{helpers:Localize Label_LogLevel}"
                                           VerticalAlignment="Center"/>
                                
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          ItemsSource="{Binding LogLevels}"
                                          SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </Grid>
                        </Border>
                        
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>