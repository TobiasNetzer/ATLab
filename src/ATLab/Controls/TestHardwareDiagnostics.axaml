<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.TestHardwareDiagnostics"
             x:DataType="vm:TestHardwareDiagnosticsViewModel"
             Width="300">
    
    <Grid RowDefinitions="Auto,*">
            
        <Border Grid.Row="0"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            <TextBlock Text="{helpers:Localize Header_TestHardwareDiagnostics}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
            
        <Border Grid.Row="1"
                CornerRadius="0 0 15 15"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                <StackPanel Margin="10"
                            HorizontalAlignment="Stretch"
                            Spacing="10">
                    
                    <StackPanel>
                        
                        <TextBlock Text="{helpers:Localize Label_Warning}"
                                   Classes="Large"
                                   Margin="0 0 0 5"/>
                                        
                        <TextBlock Text="{helpers:Localize Warning_DisconnectEverything}"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                        
                    </StackPanel>
                    
                    <CheckBox Content="{helpers:Localize Label_IHaveDisconnectedEverything}"
                              IsChecked="{Binding IsAcknowledged}"/>
                    
                    <Button Content="{helpers:Localize Button_RunRelayMatrixTest}"
                            Background="{DynamicResource ButtonBackground}"
                            Classes="Secondary"
                            HorizontalAlignment="Center"
                            Command="{Binding RunSelfTestCommand}"/>
                    
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsSelfTestRunning}"
                                 Margin="10"/>
                    
                    <TextBlock Text="{Binding SelfTestResult}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{Binding SelfTestPassed, Converter={StaticResource ResultBrushConverter}}"
                               IsVisible="{Binding SelfTestResult, Converter={StaticResource StringNotEmptyConverter}}"/>
                    
                        
                    <Grid ColumnDefinitions="*,100,*,100,*"
                          RowDefinitions="Auto,Auto"
                          IsVisible="{Binding HasDefectiveRelays}">
                        
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{helpers:Localize Label_MatrixH}"
                                   Classes="Small"
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Grid.Column="3"
                                   Grid.Row="0"
                                   Text="{helpers:Localize Label_MatrixL}"
                                   Classes="Small"
                                   HorizontalAlignment="Center"/>
                        
                        <ItemsControl Grid.Column="1"
                                      Grid.Row="1"
                                      ItemsSource="{Binding DefectiveRelaysMatrixH}"
                                      Margin="0 10 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"
                                                 HorizontalAlignment="Center"
                                                 ColumnSpacing="10"
                                                 RowSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <ItemsControl Grid.Column="3"
                                      Grid.Row="1"
                                      ItemsSource="{Binding DefectiveRelaysMatrixL}"
                                      Margin="0 10 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"
                                                 HorizontalAlignment="Center"
                                                 ColumnSpacing="10"
                                                 RowSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>