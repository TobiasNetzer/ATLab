<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.ExternalProgramEditor"
             x:DataType="controls:ExternalProgramEditor"
             Width="500">

    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        
        <Border Classes="WithDynamicCorner"
                Classes.expanded="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}"
                Background="{DynamicResource OutlineColor}"
                Padding="10">

            <DockPanel>
                <TextBlock Text="{helpers:Localize Header_ExternalProgram}"
                           Classes="h4"
                           VerticalAlignment="Center"/>
                
                <Button Command="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.ToggleExpandedCommand}"
                        Classes="Ghost"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                    <shadui:ButtonAssist.Icon>
                        <Grid>
                            <ContentControl Content="{LucideIconContent ChevronDown}"
                                            IsVisible="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                            <ContentControl Content="{LucideIconContent ChevronUp}"
                                            IsVisible="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}"/>
                        </Grid>
                    </shadui:ButtonAssist.Icon>
                </Button>
            </DockPanel>
        </Border>
        
        <Border CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                IsVisible="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}">

            <StackPanel Margin="10" Spacing="15">

                <TextBox Text="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.ExternalProgram.Command}"/>

                <CheckBox Content="{helpers:Localize Label_EvaluateOutput}"
                          IsChecked="{Binding $parent[controls:ExternalProgramEditor].ExternalProgramEditorVm?.ExternalProgram.EvaluateOutput, Mode=TwoWay}"/>

            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>