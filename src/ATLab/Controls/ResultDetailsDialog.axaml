<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.ResultDetailsDialog"
             x:DataType="vm:ResultDetailsDialogViewModel"
             Width="640">

    <Grid Margin="20"
          RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="10">

        <TextBlock Grid.Row="0"
                   Text="{helpers:Localize Header_ResultDetails}"
                   FontSize="18"
                   FontWeight="DemiBold"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding StepTitle}"
                   Classes="Muted"
                   TextTrimming="CharacterEllipsis"/>

        <TextBox Grid.Row="2"
                 Text="{Binding Details}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="360"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,10,0,0">

            <Button Content="{helpers:Localize Button_CopyToClipboard}"
                    Classes="Outline"
                    Click="OnCopyClicked"
                    Width="130"/>

            <Button Content="{helpers:Localize Button_Close}"
                    Classes="Primary"
                    Command="{Binding CloseCommand}"
                    HotKey="Escape"
                    Width="130"/>
        </StackPanel>
    </Grid>
</UserControl>
