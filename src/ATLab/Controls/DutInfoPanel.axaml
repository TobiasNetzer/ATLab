<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.DutInfoPanel"
             x:DataType="vm:DeviceUnderTestInfoPanelViewModel"
             Width="300">
    
    <Grid RowDefinitions="Auto,*">
            
        <Border Grid.Row="0"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            <TextBlock Text="{helpers:Localize Header_DeviceUnderTest}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
            
        <Border Grid.Row="1"
                CornerRadius="0 0 15 15"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2">
                    
            <StackPanel Margin="10"
                        Spacing="10"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch">
                
                <TextBlock Text="{helpers:Localize Description_DeviceUnderTest}"
                           TextWrapping="Wrap"
                           FontSize="14"/>

                <StackPanel Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_Name}"/>
                    <TextBox Text="{Binding DeviceUnderTestInfo.DeviceName, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_Revision}"/>
                    <TextBox Text="{Binding DeviceUnderTestInfo.Revision, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_Variant}"/>
                    <TextBox Text="{Binding DeviceUnderTestInfo.Variant, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_PartNumber}"/>
                    <TextBox Text="{Binding DeviceUnderTestInfo.PartNumber, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_AdditionalNotes}"/>
                    <TextBox Text="{Binding DeviceUnderTestInfo.AdditionalNotes, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Height="100"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
