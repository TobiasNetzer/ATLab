<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="ATLab.Controls.About"
             x:DataType="vm:AboutTabViewModel"
             Width="780"
             VerticalAlignment="Top">

        <Grid RowDefinitions="Auto,*">
            
            <Border Grid.Row="0"
                    Background="{DynamicResource OutlineColor}"
                    CornerRadius="15 15 0 0"
                    Padding="10">
                <TextBlock Text="{helpers:Localize About_Title}"
                           Classes="h4"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <Border Grid.Row="1"
                    CornerRadius="0 0 15 15"
                    BorderBrush="{DynamicResource OutlineColor}"
                    BorderThickness="2">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <StackPanel Margin="20"
                                Spacing="20">
                        
                        <Image Source="avares://ATLab/Assets/AppIcon.png"
                               Height="100"/>
                        
                        <TextBlock Text="ATLab"
                                   Classes="h2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{helpers:Localize About_Description}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Classes="Caption"
                                   FontSize="14"/>

                        <Border Background="{DynamicResource MutedColor}"
                                BorderThickness="1"/>
                        
                        <Grid ColumnDefinitions="*,Auto">
                            
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{Binding AppName}" Classes="Large"/>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{helpers:Localize About_Version}" FontSize="14"/>
                                    <TextBlock Text="{Binding AppVersion}" FontSize="14"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Copyright}" FontSize="14"/>

                                <TextBlock Text="{helpers:Localize About_Build}"
                                           Classes="Large"
                                           Margin="0 5 0 0"/>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{helpers:Localize About_Date}" FontSize="14"/>
                                    <TextBlock Text="{Binding BuildDate}" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{helpers:Localize About_Configuration}" FontSize="14"/>
                                    <TextBlock Text="{Binding BuildConfiguration}" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{helpers:Localize About_Avalonia}" FontSize="14"/>
                                    <TextBlock Text="{Binding AvaloniaVersion}" FontSize="14"/>
                                </StackPanel>

                                <TextBlock Text="{helpers:Localize About_System}"
                                           Classes="Large"
                                           Margin="0 5 0 0"/>

                                <TextBlock Text="{Binding OSInfo}" FontSize="14"/>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{helpers:Localize About_Runtime}" FontSize="14"/>
                                    <TextBlock Text="{Binding RuntimeFramework}" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="5">
                                
                                <Button
                                    Content="{helpers:Localize Button_ViewProjectOnGitHub}"
                                    Classes="Outline"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="https://github.com/TobiasNetzer/ATLab">
                                    <shadui:ButtonAssist.Icon>
                                        <ContentControl Content="{LucideIconContent ExternalLink, 16}" Margin="0,0,8,0"/>
                                    </shadui:ButtonAssist.Icon>
                                </Button>
                                
                                <Button
                                    Content="{helpers:Localize Button_License}"
                                    Classes="Outline"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="https://github.com/TobiasNetzer/ATLab/blob/main/LICENSE">
                                    <shadui:ButtonAssist.Icon>
                                        <ContentControl Content="{LucideIconContent Scale, 16}" Margin="0,0,8,0"/>
                                    </shadui:ButtonAssist.Icon>
                                </Button>
                                
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
</UserControl>