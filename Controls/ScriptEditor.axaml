<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="ATLab.Controls.ScriptEditor"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:DataType="vm:ScriptingTabViewModel">
    
    <Grid RowDefinitions="auto, *">
        
        <Border Grid.Row="0"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
                            
            <TextBlock Text="{helpers:Localize Header_ScriptEditor}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
        
        
        <Border Grid.Row="1"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}">
            
            <Grid ColumnDefinitions="auto, *"
                  RowDefinitions="auto, *">
            
                <StackPanel Grid.Column="0"
                            Grid.Row="0">
                    
                    <Border BorderBrush="{DynamicResource OutlineColor}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Margin="10 10 10 0">
                        
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="10">
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_NewScript}"
                                Command="{Binding NewScriptCommand}"
                                Width="40"
                                Height="40">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent FilePlusCorner}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_SaveScript}"
                                Command="{Binding SaveScriptCommand}"
                                Width="40"
                                Height="40">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Save}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_DeleteScript}"
                                Command="{Binding DeleteScriptCommand}"
                                Width="40"
                                Height="40">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Trash}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                Command="{Binding ChangeRepositoryCommand}"
                                Width="40"
                                Height="40">
                                <Button.Styles>
                                    <Style Selector="ToolTip">
                                        <Setter Property="MaxWidth" Value="1500"/>
                                    </Style>
                                </Button.Styles>
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent FolderOpen}"/>
                                </shadui:ButtonAssist.Icon>
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="{helpers:Localize ToolTip_ChangeScriptFolder}"/>
                                        <TextBlock Text="{Binding ScriptFolderPath}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </ToolTip.Tip>
                            </Button>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_ReloadScriptFolder}"
                                Command="{Binding ReloadScriptsCommand}"
                                Width="40"
                                Height="40">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent RotateCcw}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                        
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Grid Grid.Column="0"
                      Grid.Row="1"
                      RowDefinitions="auto, *"
                      Margin="10"
                      RowSpacing="2">
                    
                    <TextBlock Grid.Row="0" Text="{helpers:Localize Label_Scripts}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Scripts}"
                             SelectedItem="{Binding SelectedScript , Mode=TwoWay}"
                             Width="300"
                             BorderBrush="{DynamicResource OutlineColor}"
                             BorderThickness="2">
                        
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ Border#SelectionBackground">
                                <Setter Property="Background" Value="{DynamicResource InfoColor}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                        </ListBox.Styles>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                
                <Grid Grid.Row="0"
                      Grid.Column="1"
                      Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,*"
                      ColumnDefinitions="*,*"
                      Margin="0 10 10 10"
                      RowSpacing="10"
                      ColumnSpacing="10">
                    
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Spacing="2">
                        
                        <TextBlock Text="{helpers:Localize Label_Name}"/>
                        
                        <TextBox Text="{Binding SelectedScript?.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="50"/>
                        
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Spacing="2">
                        
                        <TextBlock Text="{helpers:Localize Label_Description}"/>
                        
                        <TextBox Text="{Binding SelectedScript?.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"/>
                        
                    </StackPanel>
                    
                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          RowDefinitions="Auto,*"
                          RowSpacing="2">
                        
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            
                            <TextBlock Text="{helpers:Localize Label_Variables}" VerticalAlignment="Bottom"/>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_AddVariable}"
                                Command="{Binding SelectedScript?.AddVariableCommand}"
                                Width="35"
                                Height="35">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Plus}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                    
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_RemoveVariable}"
                                Command="{Binding SelectedScript?.RemoveVariableCommand}"
                                Width="35"
                                Height="35">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Minus}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1"
                                  Classes="HorizontalScroll Compact"
                                  ItemsSource="{Binding SelectedScript?.Variables}"
                                  SelectedIndex="{Binding SelectedScript?.SelectedVariableIndex}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  BorderThickness="2"
                                  BorderBrush="{DynamicResource OutlineColor}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Height="130">
                            
                            <DataGrid.Styles>
                                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{DynamicResource InfoColor}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </DataGrid.Styles>
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{helpers:Localize Header_VariableName}" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="{helpers:Localize Header_DefaultValue}" Binding="{Binding Value}" Width="200"/>
                            </DataGrid.Columns>
                        
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{helpers:Localize Menu_Add}" Command="{Binding SelectedScript?.AddVariableCommand}"/>
                                    <MenuItem Header="{helpers:Localize Menu_Remove}" Command="{Binding SelectedScript?.RemoveVariableCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                    
                    <Grid Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          RowDefinitions="Auto,*,Auto"
                          RowSpacing="2">
                        
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            
                            <TextBlock Text="{helpers:Localize Label_Commands}" VerticalAlignment="Bottom"/>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_AddCommand}" 
                                Command="{Binding SelectedScript?.AddCommandCommand}"
                                Width="35"
                                Height="35">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Plus}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                    
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="{helpers:Localize ToolTip_RemoveCommand}" 
                                Command="{Binding SelectedScript?.RemoveCommandCommand}"
                                Width="35"
                                Height="35">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent Minus}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1"
                                  Classes="HorizontalScroll Compact"
                                  ItemsSource="{Binding SelectedScript?.Commands}"
                                  SelectedIndex="{Binding SelectedScript?.SelectedCommandIndex, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  BorderThickness="2"
                                  BorderBrush="{DynamicResource OutlineColor}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                            <DataGrid.Styles>
                                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                                    <Setter Property="Fill" Value="{DynamicResource InfoColor}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                                
                                <Style Selector="TextBlock.TrimmedCell">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style Selector="ToolTip">
                                    <Setter Property="MaxWidth" Value="600"/>
                                </Style>
                            </DataGrid.Styles>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{helpers:Localize Header_Command}" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ScriptCommandViewModel">
                                            <TextBlock Classes="TrimmedCell"
                                                       Text="{Binding Command}"
                                                       ToolTip.Tip="{Binding CommandToolTip}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate x:DataType="vm:ScriptCommandViewModel">
                                            <TextBox Text="{Binding Command}"
                                                     VerticalAlignment="Stretch"
                                                     helpers:FocusExtensions.FocusWhenVisible="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{helpers:Localize Header_ExpectResponse}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding IsExpectResponse}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{helpers:Localize Header_Evaluate}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <RadioButton
                                                IsChecked="{Binding IsEvaluate}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{helpers:Localize Header_CheckResponse}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding IsCheckResponse}"
                                                IsEnabled="{Binding CanCheckResponse}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{helpers:Localize Header_DelayMs}" Binding="{Binding DelayMs}"/>
                                <DataGridTextColumn Header="{helpers:Localize Header_TimeoutMs}" Binding="{Binding TimeoutMs}"/>
                            </DataGrid.Columns>
                        
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{helpers:Localize Menu_Add}" Command="{Binding SelectedScript?.AddCommandCommand}"/>
                                    <MenuItem Header="{helpers:Localize Menu_Remove}" Command="{Binding SelectedScript?.RemoveCommandCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Margin="0 8 0 0"
                                BorderBrush="{DynamicResource OutlineColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10"
                                IsVisible="{Binding SelectedScript.SelectedCommand, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">

                            <StackPanel DataContext="{Binding SelectedScript.SelectedCommand}"
                                        x:CompileBindings="False"
                                        x:DataType="vm:ScriptCommandViewModel"
                                        Spacing="10">

                                <TextBlock Text="{helpers:Localize Header_ResponseCheck}"
                                           Classes="Large"/>

                                <CheckBox Content="{helpers:Localize Label_CheckResponse}"
                                          IsChecked="{Binding IsCheckResponse}"
                                          IsEnabled="{Binding CanCheckResponse}"/>

                                <TextBlock Text="{helpers:Localize Text_ResponseCheckNotAvailable}"
                                           Classes="Muted"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !CanCheckResponse}"/>
                                
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">

                                <Grid ColumnSpacing="10"
                                      Margin="0 0 0 12"
                                      IsEnabled="{Binding IsResponseChecked}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="250"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{helpers:Localize Label_Mask}"/>
                                        <TextBox Text="{Binding CheckMask, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{helpers:Localize Label_Skip}"/>
                                        <TextBox Text="{Binding CheckSkip, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{helpers:Localize Label_Length}"/>
                                        <TextBox Text="{Binding CheckLength, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock Text="{helpers:Localize Label_LowerLimit}"/>
                                        <TextBox Text="{Binding CheckLowerLimit, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Spacing="2">
                                        <TextBlock Text="{helpers:Localize Label_UpperLimit}"/>
                                        <TextBox Text="{Binding CheckUpperLimit, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>