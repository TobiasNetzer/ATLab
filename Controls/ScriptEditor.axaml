<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.ScriptEditor"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:ScriptingTabViewModel"
             Width="1200">
    
    <Grid RowDefinitions="auto, *">
        
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBorder}"
                CornerRadius="15 15 0 0"
                Padding="10">
                            
            <TextBlock Text="Script Editor"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>
        
        
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackground}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource PanelBorder}">
            
            <Grid ColumnDefinitions="auto, *"
                  RowDefinitions="auto, *">
            
                <StackPanel Grid.Column="0"
                            Grid.Row="0">
                    
                    <Border Background="{DynamicResource ToolbarBackground}"
                            CornerRadius="5"
                            Margin="10 10 10 0">
                        
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="10">
                        
                            <Button Content="&#xED0E;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="20"
                                    ToolTip.Tip="New script"
                                    Command="{Binding NewScriptCommand}"/>

                            <Button Content="&#xE74E;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="20"
                                    ToolTip.Tip="Save script"
                                    Command="{Binding SaveScriptCommand}"/>
                        
                            <Button Content="&#xE74D;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="20"
                                    ToolTip.Tip="Delete script"
                                    Command="{Binding DeleteScriptCommand}"/>
                            
                            <Button Content="&#xED25;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="20"
                                    Command="{Binding ChangeRepositoryCommand}">
                                <Button.Styles>
                                    <Style Selector="ToolTip">
                                        <Setter Property="MaxWidth" Value="1500"/>
                                    </Style>
                                </Button.Styles>
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="Change repository folder"/>
                                        <TextBlock Text="{Binding RepositoryPath}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </ToolTip.Tip>
                            </Button>
                        
                            <Button Content="&#xE72C;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="20"
                                    ToolTip.Tip="Reload script repository"
                                    Command="{Binding ReloadScriptsCommand}"/>
                        
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Grid Grid.Column="0"
                      Grid.Row="1"
                      RowDefinitions="auto, *"
                      Margin="10"
                      RowSpacing="2">
                    
                    <TextBlock Grid.Row="0" Text="Scripts"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Scripts}"
                             SelectedItem="{Binding SelectedScript , Mode=TwoWay}"
                             Width="300"
                             Background="{DynamicResource ToolbarBackground}"
                             CornerRadius="10">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                
                <Grid Grid.Row="0"
                      Grid.Column="1"
                      Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,*"
                      ColumnDefinitions="*,*"
                      Margin="0 10 10 10"
                      RowSpacing="10"
                      ColumnSpacing="10">
                    
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Spacing="2">
                        
                        <TextBlock Text="Name"/>
                        
                        <TextBox Text="{Binding SelectedScript.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="50"/>
                        
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Spacing="2">
                        
                        <TextBlock Text="Description"/>
                        
                        <TextBox Text="{Binding SelectedScript.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"/>
                        
                    </StackPanel>
                    
                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          RowDefinitions="Auto,*"
                          RowSpacing="2">
                        
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            
                            <TextBlock Text="Variables" VerticalAlignment="Bottom"/>
                        
                            <Button Content="&#xF8AA;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="16"
                                    ToolTip.Tip="Add a new variable"
                                    Command="{Binding SelectedScript.AddVariableCommand}" />
                        
                            <Button Content="&#xF8AB;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="16"
                                    ToolTip.Tip="Remove variable"
                                    Command="{Binding SelectedScript.RemoveVariableCommand}" />
                            
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SelectedScript.Variables}"
                                  SelectedIndex="{Binding SelectedScript.SelectedVariableIndex}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  BorderThickness="1"
                                  BorderBrush="Gray"
                                  VerticalScrollBarVisibility="Auto"
                                  Height="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Variable Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Default Value" Binding="{Binding Value}" Width="200"/>
                            </DataGrid.Columns>
                        
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add" Command="{Binding SelectedScript.AddVariableCommand}"/>
                                    <MenuItem Header="Remove" Command="{Binding SelectedScript.RemoveVariableCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                    
                    <Grid Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          RowDefinitions="Auto,*"
                          RowSpacing="2">
                        
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            
                            <TextBlock Text="Commands" VerticalAlignment="Bottom"/>
                            
                            <Button Content="&#xF8AA;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="16"
                                    ToolTip.Tip="Add a new command" 
                                    Command="{Binding SelectedScript.AddCommandCommand}" />
                    
                            <Button Content="&#xF8AB;"
                                    FontFamily="{StaticResource FluentIconsFont}"
                                    FontSize="16"
                                    ToolTip.Tip="Remove command" 
                                    Command="{Binding SelectedScript.RemoveCommandCommand}" />
                            
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SelectedScript.Commands}"
                                  SelectedIndex="{Binding SelectedScript.SelectedCommandIndex, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="All"
                                  BorderThickness="1"
                                  BorderBrush="Gray"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                                <DataGridTemplateColumn Header="Expect Response">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding IsExpectResponse}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Evaluate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <RadioButton
                                                IsChecked="{Binding IsEvaluate}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayMs}"/>
                                <DataGridTextColumn Header="Timeout (ms)" Binding="{Binding TimeoutMs}"/>
                            </DataGrid.Columns>
                        
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add" Command="{Binding SelectedScript.AddCommandCommand}"/>
                                    <MenuItem Header="Remove" Command="{Binding SelectedScript.RemoveCommandCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>