<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Controls.ProjectSettings"
             x:DataType="vm:ProjectSettingsViewModel"
             Width="780">

    
    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="{DynamicResource SystemBaseLowColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            
            <TextBlock Text="Project Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border Grid.Row="1"
            Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="0 0 15 15"
            BorderThickness="2"
            BorderBrush="{DynamicResource SystemBaseLowColor}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="*,10,*"
                      RowDefinitions="Auto,*"
                      Margin="10">
                    
                    <Border Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            BorderThickness="2"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            Padding="10">

                        <StackPanel>
                            <TextBlock Text="Test settings"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Margin="0 0 0 10"/>

                            <CheckBox Content="Enter serial number"
                                      IsChecked="{Binding UseSerialNumber, Mode=TwoWay}"/>

                            <CheckBox Content="Save test result"
                                      IsChecked="{Binding SaveTestResult, Mode=TwoWay}"
                                      IsEnabled="{Binding UseSerialNumber}"/>

                            <RadioButton Content="Always"
                                         Margin="30 0 0 0"
                                         IsChecked="{Binding SaveTestResultOptions, Converter={StaticResource EnumEqualsToBool}, ConverterParameter=ALWAYS}"
                                         IsEnabled="{Binding CanSaveTestResult}"/>

                            <RadioButton Content="Passed only"
                                         Margin="30 0 0 0"
                                         IsChecked="{Binding SaveTestResultOptions, Converter={StaticResource EnumEqualsToBool}, ConverterParameter=ONLY_WHEN_PASSED}"
                                         IsEnabled="{Binding CanSaveTestResult}"/>

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Width="300"
                                         Text="{Binding SaveTestResultFilePath, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding CanSaveTestResult}"/>
                                <Button Content="..."
                                        Command="{Binding SelectSaveTestResultFilePathCommand}"
                                        IsEnabled="{Binding CanSaveTestResult}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2"
                            Grid.Row="0"
                            BorderThickness="2"
                            CornerRadius="5"
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            Padding="10">

                        <StackPanel>
                            <TextBlock Text="Measurement settings"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Margin="0 0 0 10"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="Default Tolerance (%):"
                                           VerticalAlignment="Center"/>

                                <NumericUpDown Value="{Binding ToleranceValue}"
                                               Minimum="0"
                                               Maximum="100"
                                               Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
