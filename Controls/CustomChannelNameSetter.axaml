<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.CustomChannelNameSetter"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:TestHardwareRelayChannelsViewModel"
             Width="780">
    
    <Grid RowDefinitions="Auto, *">
    
        <Border Grid.Row="0" Background="{DynamicResource SystemBaseLowColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
                
            <TextBlock Text="Custom Channel Names"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border Grid.Row="1" Background="{DynamicResource SystemChromeLowColor}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemBaseLowColor}">
        <StackPanel 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            
            <Grid RowDefinitions="Auto, *"
                  Margin=" 0 10 0 0">
                
                <TextBlock Grid.Row="0"
                           Text="Matrix Channels"
                           HorizontalAlignment="Center"
                           FontSize="16"/>
                
                <ScrollViewer Grid.Row="1" Margin="0 2 10 0">
                    <ItemsControl ItemsSource="{Binding MeasChannelViewModel.CustomChannelNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" ColumnDefinitions="30,*">
                                    <TextBlock Text="{Binding ChannelIndex}" Grid.Column="0"
                                               HorizontalAlignment="Right" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ChannelName, Mode=TwoWay}"
                                             Grid.Column="1"
                                             Width="150"
                                             Margin="0 0 20 0 "/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        
            <Grid RowDefinitions="Auto, *" 
                  Margin=" 0 10 0 0">
                
                <TextBlock Grid.Row="0"
                           Text="Stimulation Channels"
                           HorizontalAlignment="Center"
                           FontSize="16"/>
                
                <ScrollViewer Grid.Row="1" Margin="0 2 10 0">
                    <ItemsControl ItemsSource="{Binding StimChannelViewModel.StimChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" ColumnDefinitions="30,*">
                                    <TextBlock Text="{Binding State.ChannelIndex}" Grid.Column="0"
                                               HorizontalAlignment="Right" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding CustomName.ChannelName, Mode=TwoWay}"
                                             Grid.Column="1"
                                             Width="150"
                                             Margin="0 0 20 0 "/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <Grid RowDefinitions="Auto,*"
                  Margin=" 0 10 0 0">
                
                <TextBlock Grid.Row="0"
                           Text="Ext Stimulation Channels"
                           HorizontalAlignment="Center"
                           FontSize="16"/>
                
                    <ScrollViewer Grid.Row="1" Margin="0 2 10 0">
                        <ItemsControl ItemsSource="{Binding ExtStimChannelViewModel.ExtStimChannels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5" ColumnDefinitions="30,*">
                                        <TextBlock Text="{Binding State.ChannelIndex}" Grid.Column="0"
                                                   HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CustomName.ChannelName, Mode=TwoWay}"
                                                 Grid.Column="1"
                                                 Width="150"
                                                 Margin="0 0 20 0 "/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
