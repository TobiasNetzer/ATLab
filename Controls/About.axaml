<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Controls.About"
             x:DataType="vm:AboutTabViewModel"
             Width="780"
             VerticalAlignment="Top">

        <Grid RowDefinitions="Auto,*">
            
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBorder}"
                    CornerRadius="15 15 0 0"
                    Padding="10">
                <TextBlock Text="About"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="0 0 15 15"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="2">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <StackPanel Margin="20"
                                Spacing="20">
                        
                        <Image Source="avares://ATLab/Assets/AppIcon.png"
                               Height="100"/>
                        
                        <TextBlock Text="ATLab"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="A cross‑platform automated testing toolkit for interfacing with hardware via the Test Interface Adapter and controlling external test instruments through remote control interfaces. Built with Avalonia UI and .NET 9, it offers a modern environment for developing and running automated test sequences."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <Border BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1"/>
                        
                        <Grid ColumnDefinitions="*,*">
                            
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{Binding AppVersion, StringFormat=Version: {0}}"/>
                                <TextBlock Text="{Binding Author, StringFormat=Author: {0}}"/>
                                <TextBlock Text="{Binding BuildConfiguration, StringFormat=Build: {0}}"/>
                                <TextBlock Text="{Binding TargetFramework, StringFormat=Target Framework: {0}}"/>
                                <TextBlock Text="{Binding RuntimeVersion, StringFormat=.NET Runtime: {0}}"/>
                                <TextBlock Text="{Binding AvaloniaVersion, StringFormat=Avalonia: {0}}"/>
                                <TextBlock Text="{Binding OSDescription, StringFormat=OS: {0}}"/>
                                <TextBlock Text="{Binding OSArchitecture, StringFormat=OS Architecture: {0}}"/>
                                <TextBlock Text="{Binding ProcessArchitecture, StringFormat=Process Architecture: {0}}"/>
                            
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="5">
                                
                                <TextBlock HorizontalAlignment="Right">
                                    <Button Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://github.com/TobiasNetzer/ATLab">
                                        View project on GitHub
                                    </Button>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Right">
                                    <Button Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://github.com/TobiasNetzer/ATLab/blob/main/LICENSE">
                                        License
                                    </Button>
                                </TextBlock>
                                
                            </StackPanel>
                            
                        </Grid>

                    </StackPanel>

                </ScrollViewer>
            </Border>
        </Grid>
</UserControl>
