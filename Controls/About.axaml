<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Controls.About"
             x:DataType="vm:AboutTabViewModel"
             Width="780"
             VerticalAlignment="Top">

    <Border Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="15"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="2">

        <Grid RowDefinitions="Auto,Auto">
            
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemBaseLowColor}"
                    CornerRadius="15 15 0 0"
                    Padding="12">
                <TextBlock Text="About"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <StackPanel Grid.Row="1"
                        Margin="30"
                        Spacing="20">

                <TextBlock Text="ATLab"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="A cross‑platform automated testing toolkit for interfacing with hardware via the Test Interface Adapter and controlling external test instruments through remote control interfaces. Built with Avalonia UI and .NET 9, it offers a modern environment for developing and running automated test sequences."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Separator Margin="0"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Application" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat=Version: {0}}"/>
                    <TextBlock Text="{Binding Author, StringFormat=Author: {0}}"/>
                </StackPanel>

                <Separator Margin="0"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Connected Test Hardware" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DeviceName, StringFormat=Device: {0}}"/>
                    <TextBlock Text="{Binding SerialNumber, StringFormat=Serial Number: {0}}"/>
                    <TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware: {0}}"/>
                    <TextBlock Text="{Binding BuildDate, StringFormat=Build Date: {0}}"/>
                    <TextBlock Text="{Binding BuildTime, StringFormat=Build Time: {0}}"/>
                </StackPanel>

                <Separator Margin="0"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Available Relay Channels" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MeasChannelCount, StringFormat=Meas Channels: {0}}"/>
                    <TextBlock Text="{Binding StimChannelCount, StringFormat=Stim Channels: {0}}"/>
                    <TextBlock Text="{Binding ExtStimChannelCount, StringFormat=External Stim Channels: {0}}"/>
                </StackPanel>
                
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
