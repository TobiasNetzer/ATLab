<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.TestStepConfigurator"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:DataType="vm:TestStepConfiguratorViewModel"
             Width="500">
    
    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
        
        <Style Selector="ComboBox /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="250"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel>
        
        <Border Background="{DynamicResource PanelBorder}"
                Classes="WithDynamicCorner"
                Classes.expanded="{Binding IsExpanded}"
                Padding="10"
                Margin="0">
            <DockPanel>
                <TextBlock Text="Test Step Configuration"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="5">
                                <Grid>
                                    <TextBlock Text="&#xE70D;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="&#xE70E;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource PanelBackground}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource PanelBorder}"
                IsVisible="{Binding IsExpanded}">
            
            <StackPanel Margin="10"
                        Spacing="10">
            
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    <TextBlock Text="Name"/>
                    <TextBox Text="{Binding TestStepViewModel.TestStep.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             helpers:FocusExtensions.MoveFocusOnEnter="True"
                             TabIndex="0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Lower Limit"/>
                        <TextBox Text="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="2"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Nominal"/>
                        <TextBox Text="{Binding NominalValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="1"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Upper Limit"/>
                        <TextBox Text="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="3"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2"
                                Margin="35 0 0 0">
                        <TextBlock Text="Unit"/>
                        <TextBox Text="{Binding TestStepViewModel.TestStep.Unit, Mode=TwoWay, FallbackValue=''}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="4"
                                 MaxLength="10"
                                 Width="80"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Delay"/>
                        <TextBox Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="5"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Evaluate"/>
                        <ComboBox ItemsSource="{Binding EvaluationSources}"
                                  MinWidth="100"
                                  SelectedItem="{Binding TestStepViewModel.TestStep.EvaluationSource, FallbackValue=''}"
                                  DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                  TabIndex="6"/>
                        
                    </StackPanel>
                    
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    
                    <TextBlock Text="Comment"
                               VerticalAlignment="Bottom"/>
                    
                    <TextBox Text="{Binding TestStepViewModel.TestStep.Comment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             TabIndex="7"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                    
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    
                    <CheckBox
                        Content="Show Comment"
                        TabIndex="8"
                        IsEnabled="{Binding TestStepViewModel.TestStep.EvaluationSource, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=USER_RESPONSE, FallbackValue='True'}"
                        IsChecked="{Binding TestStepViewModel.TestStep.IsShowComment, FallbackValue=False}"/>
                    
                    <Button Content="&#xE8B9;"
                            FontFamily="{StaticResource FluentIconsFont}"
                            FontSize="20"
                            ToolTip.Tip="Add image to message box"
                            TabIndex="9"
                            Command="{Binding OpenImagePickerCommand}"/>
                    
                    <TextBox TabIndex="10"
                             Width="285"
                             Text="{Binding TestStepViewModel.TestStep.CustomMessageBoxImagePath, FallbackValue=''}"/>
                    
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Text="Advanced Settings"
                               VerticalAlignment="Center"/>
                    
                    <Separator Width="300"/>

                    <ToggleButton IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}"
                                  TabIndex="11">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border Background="Transparent" Padding="5">
                                    <Grid>
                                        <TextBlock Text="&#xE70D;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="18"
                                                   IsVisible="{Binding IsAdvancedExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                        <TextBlock Text="&#xE70E;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="18"
                                                   IsVisible="{Binding IsAdvancedExpanded}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
                
                <StackPanel IsVisible="{Binding IsAdvancedExpanded}"
                            Spacing="10">
                        
                    <CheckBox Content="Ignore Step"
                              TabIndex="12"
                              IsChecked="{Binding TestStepViewModel.TestStep.IsIgnoreStep, FallbackValue='False'}"/>
            
                    <CheckBox Content="Exclude from Export"
                              TabIndex="13"
                              IsChecked="{Binding TestStepViewModel.TestStep.IsExcludeFromExport, FallbackValue='False'}"/>
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        
                        <CheckBox Content="Assign Result to Variable"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding TestStepViewModel.TestStep.IsAssignResultToVariable, FallbackValue='False'}"/>
                        <ComboBox
                            Width="275"
                            TabIndex="14"
                            ItemsSource="{Binding RuntimeVariables}"
                            SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                            IsEnabled="{Binding TestStepViewModel.TestStep.IsAssignResultToVariable, FallbackValue='False'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                    </StackPanel>
                    
                    
                    <Grid ColumnDefinitions="*,*">
                        
                        <StackPanel Grid.Column="0">
                        
                            <TextBlock Text="Pass-Action" FontWeight="Bold"
                                       Margin="0 0 0 5"/>
                            
                            <CheckBox Content="Invert Result"
                                      TabIndex="15"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnPass.IsInvertResult, FallbackValue='False'}"/>
                        
                            <RadioButton Content="Continue"
                                         TabIndex="16"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CONTINUE, FallbackValue='False'}"/>

                            <RadioButton Content="Repeat"
                                         TabIndex="17"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=REPEAT, FallbackValue='False'}"/>

                            <RadioButton Content="End Test"
                                         TabIndex="18"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=END_TEST, FallbackValue='False'}"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <RadioButton Content="Jump To"
                                             TabIndex="19"
                                             GroupName="PassAction"
                                             IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}"/>

                                <ComboBox Width="130"
                                          TabIndex="20"
                                          ItemsSource="{Binding JumpTargets}"
                                          SelectedItem="{Binding SelectedPassJumpTarget, Mode=TwoWay}"
                                          IsEnabled="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            
                        </StackPanel>
                    
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right">
                        
                            <TextBlock Text="Fail-Action" FontWeight="Bold"
                                       Margin="0 0 0 5"/>
                            
                            <CheckBox Content="Invert Result"
                                      TabIndex="21"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnFail.IsInvertResult, FallbackValue='False'}"/>
                        
                            <RadioButton Content="Continue"
                                         TabIndex="22"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CONTINUE, FallbackValue='False'}"/>

                            <RadioButton Content="Repeat"
                                         TabIndex="23"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=REPEAT, FallbackValue='False'}"/>

                            <RadioButton Content="End Test"
                                         TabIndex="24"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=END_TEST, FallbackValue='False'}"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <RadioButton Content="Jump To"
                                             TabIndex="25"
                                             GroupName="FailAction"
                                             IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}"/>

                                <ComboBox Width="130"
                                          TabIndex="26"
                                          ItemsSource="{Binding JumpTargets}"
                                          SelectedItem="{Binding SelectedFailJumpTarget, Mode=TwoWay}"
                                          IsEnabled="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>