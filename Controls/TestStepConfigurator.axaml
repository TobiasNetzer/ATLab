<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.TestStepConfigurator"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:DataType="vm:TestStepConfiguratorViewModel"
             Width="500">
    
    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel>
        
        <Border Background="{DynamicResource PanelBorder}"
                Classes="WithDynamicCorner"
                Classes.expanded="{Binding IsExpanded}"
                Padding="10"
                Margin="0">
            <DockPanel>
                <TextBlock Text="Test Step Configuration"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="5">
                                <Grid>
                                    <TextBlock Text="&#xE70D;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="&#xE70E;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource PanelBackground}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource PanelBorder}"
                IsVisible="{Binding IsExpanded}">
            
            <StackPanel Margin="10"
                        Spacing="10">
            
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    <TextBlock Text="Name"/>
                    <TextBox Text="{Binding TestStepViewModel.TestStep.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             helpers:FocusExtensions.MoveFocusOnEnter="True"
                             TabIndex="0"
                             MaxLength="50"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Lower Limit"/>
                        <TextBox Text="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="2"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Nominal"/>
                        <TextBox Text="{Binding NominalValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="1"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Upper Limit"/>
                        <TextBox Text="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="3"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2"
                                Margin="35 0 0 0">
                        <TextBlock Text="Unit"/>
                        <TextBox Text="{Binding TestStepViewModel.TestStep.Unit, Mode=TwoWay, FallbackValue=''}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="4"
                                 MaxLength="10"
                                 Width="80"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Delay"/>
                        <TextBox Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="5"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="Evaluate"/>
                        <ComboBox ItemsSource="{Binding EvaluationSources}"
                                  MinWidth="100"
                                  SelectedItem="{Binding TestStepViewModel.TestStep.EvaluationSource, FallbackValue=''}"
                                  DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                  TabIndex="6"/>
                        
                    </StackPanel>
                    
                    <CheckBox VerticalAlignment="Bottom"
                              Content="Custom Response Mask"
                              TabIndex="7"
                              IsChecked="{Binding TestStepViewModel.TestStep.CustomMask, FallbackValue='False'}"/>
                    
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    
                    <TextBlock Text="Comment"
                               VerticalAlignment="Bottom"/>
                    
                    <TextBox Text="{Binding TestStepViewModel.TestStep.Comment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             TabIndex="8"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                    
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    
                    <CheckBox
                        Content="Show Message"
                        TabIndex="9"
                        IsChecked="{Binding TestStepViewModel.TestStep.ShowCommentOnTestStart, FallbackValue=False}"/>
                    
                    <Button Content="&#xE8B9;"
                            FontFamily="{StaticResource FluentIconsFont}"
                            FontSize="20"
                            ToolTip.Tip="Add image to message box"
                            TabIndex="10"
                            Command="{Binding OpenImagePickerCommand}"/>
                    
                    <TextBox TabIndex="11"
                             Width="290"
                             Text="{Binding TestStepViewModel.TestStep.CustomMessageBoxImagePath, FallbackValue=''}"/>
                    
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Text="Advanced Settings"
                               VerticalAlignment="Center"/>
                    
                    <Separator Width="300"/>

                    <ToggleButton IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border Background="Transparent" Padding="5">
                                    <Grid>
                                        <TextBlock Text="&#xE70D;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="18"
                                                   IsVisible="{Binding IsAdvancedExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                        <TextBlock Text="&#xE70E;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="18"
                                                   IsVisible="{Binding IsAdvancedExpanded}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
                
                <StackPanel IsVisible="{Binding IsAdvancedExpanded}"
                            Spacing="10">
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                
                        <CheckBox Content="Repeat Until Pass"
                                  TabIndex="12"
                                  IsChecked="{Binding TestStepViewModel.TestStep.RepeatUntilPass, FallbackValue='False'}"/>
                
                        <CheckBox Content="Ignore Step"
                                  TabIndex="13"
                                  IsChecked="{Binding TestStepViewModel.TestStep.IgnoreStep, FallbackValue='False'}"/>
                
                        <CheckBox Content="Don't Save Result"
                                  TabIndex="14"
                                  IsChecked="{Binding TestStepViewModel.TestStep.DontSaveResult, FallbackValue='False'}"/>
                
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="*,*">
                        
                        <StackPanel Grid.Column="0">
                        
                            <TextBlock Text="Pass-Condition" FontWeight="Bold"/>
                        
                            <RadioButton Content="Continue"/>
                            <RadioButton Content="Repeat"/>
                            <RadioButton Content="End Test"/>
                            <RadioButton Content="Jump"/>
                            
                        </StackPanel>
                    
                        <StackPanel Grid.Column="1">
                        
                            <TextBlock Text="Fail-Condition" FontWeight="Bold"/>
                        
                            <RadioButton Content="Continue"/>
                            <RadioButton Content="Repeat"/>
                            <RadioButton Content="End Test"/>
                            <RadioButton Content="Jump"/>
                            
                        </StackPanel>
                        
                    </Grid>
                    
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
