<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="ATLab.Controls.TestStepConfigurator"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:DataType="vm:TestStepConfiguratorViewModel"
             Width="500">
    
    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
        
        <Style Selector="ComboBox /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="250"/>
        </Style>
        
        <Style Selector="ComboBox.JumpTarget /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="450"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel>
        
        <Border Background="{DynamicResource OutlineColor}"
                Classes="WithDynamicCorner"
                Classes.expanded="{Binding IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}"
                Padding="10">
            <DockPanel>
                <TextBlock Text="{helpers:Localize Header_TestStepConfiguration}"
                           Classes="h4"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <Button Command="{Binding ToggleExpandedCommand}"
                        Classes="Ghost"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                    <shadui:ButtonAssist.Icon>
                        <Grid>
                            <ContentControl Content="{LucideIconContent ChevronDown}"
                                            IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                            <ContentControl Content="{LucideIconContent ChevronUp}"
                                            IsVisible="{Binding IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}"/>
                        </Grid>
                    </shadui:ButtonAssist.Icon>
                </Button>
            </DockPanel>
        </Border>
        
        <Border CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                IsVisible="{Binding IsExpanded, Converter={StaticResource NullableBoolToBoolConverter}}">
            
            <StackPanel Margin="10"
                        Spacing="10">
            
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    <TextBlock Text="{helpers:Localize Label_Name}"/>
                    <TextBox x:Name="StepNameTextBox"
                             Text="{Binding TestStepViewModel.TestStep.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             helpers:FocusExtensions.MoveFocusOnEnter="True"
                             TabIndex="0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="{helpers:Localize Label_LowerLimit}"/>
                        <TextBox Text="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="2"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="{helpers:Localize Label_Nominal}"/>
                        <TextBox Text="{Binding NominalValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="1"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="{helpers:Localize Label_UpperLimit}"/>
                        <TextBox Text="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="3"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2"
                                Margin="35 0 0 0">
                        <TextBlock Text="{helpers:Localize Label_Unit}"/>
                        <TextBox Text="{Binding TestStepViewModel.TestStep.Unit, Mode=TwoWay, FallbackValue=''}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="4"
                                 MaxLength="10"
                                 Width="80"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            Spacing="20">
                    
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="{helpers:Localize Label_Delay}"/>
                        <TextBox Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 helpers:FocusExtensions.MoveFocusOnEnter="True"
                                 TabIndex="5"
                                 MaxLength="20"
                                 Width="100"/>
                    </StackPanel>
                
                    <StackPanel Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Text="{helpers:Localize Label_Evaluate}"/>
                        <ComboBox ItemsSource="{Binding EvaluationSources}"
                                  SelectedItem="{Binding TestStepViewModel.TestStep.EvaluationSource}"
                                  MinWidth="100">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>

                        </ComboBox>
                        
                    </StackPanel>
                    
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical"
                            Spacing="2">
                    
                    <TextBlock Text="{helpers:Localize Label_Comment}"
                               VerticalAlignment="Bottom"/>
                    
                    <TextBox Text="{Binding TestStepViewModel.TestStep.Comment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             TabIndex="7"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                    
                </StackPanel>
                
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    
                    <TextBlock Grid.Column="0"
                               Text="{helpers:Localize Label_AdvancedSettings}"
                               VerticalAlignment="Center"
                               Classes="Small"/>
                    
                    <Separator Grid.Column="1"
                               Background="{DynamicResource MutedColor}"/>

                    <Button Grid.Column="2"
                            Command="{Binding ToggleAdvancedSettingsCommand}"
                            Classes="Ghost"
                            TabIndex="8">
                        <shadui:ButtonAssist.Icon>
                            <Grid>
                                <ContentControl Content="{LucideIconContent ChevronDown}"
                                                IsVisible="{Binding IsAdvancedExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                <ContentControl Content="{LucideIconContent ChevronUp}"
                                                IsVisible="{Binding IsAdvancedExpanded}"/>
                            </Grid>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                </Grid>
                
                <StackPanel IsVisible="{Binding IsAdvancedExpanded}"
                            Spacing="10">
                    
                    <Grid ColumnDefinitions="240,*"
                          ColumnSpacing="10">
                        
                        <StackPanel Grid.Column="0" Spacing="20">
                            
                            <CheckBox Content="{helpers:Localize Label_IgnoreStep}"
                                      TabIndex="9"
                                      IsChecked="{Binding TestStepViewModel.TestStep.IsIgnoreStep, FallbackValue='False'}"/>
            
                            <CheckBox Content="{helpers:Localize Label_ExcludeFromExport}"
                                      TabIndex="10"
                                      IsChecked="{Binding TestStepViewModel.TestStep.IsExcludeFromExport, FallbackValue='False'}"/>
                            
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    Spacing="2"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{helpers:Localize Label_AccentColor}"/>
                            <ColorPicker
                                TabIndex="11"
                                Color="{Binding TestStepViewModel?.TestStep.StepColor, Mode=TwoWay}"/>
                        </StackPanel>
                        
                    </Grid>
                    
                    <Grid ColumnDefinitions="240,*"
                          ColumnSpacing="10">
                    
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            
                            <CheckBox Content="{helpers:Localize Label_ShowComment}"
                                      TabIndex="12"
                                      IsEnabled="{Binding TestStepViewModel.TestStep.EvaluationSource, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=USER_RESPONSE, FallbackValue='True'}"
                                      IsChecked="{Binding TestStepViewModel.TestStep.IsShowComment, FallbackValue=False}"/>
                        
                            <Button Background="{DynamicResource ButtonBackground}"
                                    Classes="Icon"
                                    ToolTip.Tip="{helpers:Localize ToolTip_AddImageToMessageBox}"
                                    TabIndex="13"
                                    Command="{Binding OpenImagePickerCommand}"
                                    Width="40"
                                    Height="40">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent ImagePlus}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                            
                        </StackPanel>
                        
                    
                        <TextBox Grid.Column="1"
                                 TabIndex="14"
                                 Text="{Binding TestStepViewModel.TestStep.CustomMessageBoxImagePath, FallbackValue=''}"/>
                    
                    </Grid>
                    
                    <Grid ColumnDefinitions="240,*"
                          ColumnSpacing="10">
                        
                        <CheckBox Grid.Column="0" Content="{helpers:Localize Label_AssignResultToVariable}"
                                  TabIndex="15"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding TestStepViewModel.TestStep.IsAssignResultToVariable, FallbackValue='False'}"/>
                        
                        <ComboBox Grid.Column="1"
                            TabIndex="16"
                            ItemsSource="{Binding VariableOptions}"
                            SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                            IsEnabled="{Binding TestStepViewModel.TestStep.IsAssignResultToVariable, FallbackValue='False'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*">
                        
                        <StackPanel Grid.Column="0"
                                    Spacing="10">
                        
                            <TextBlock Text="{helpers:Localize Header_PassAction}"
                                       Classes="Large"
                                       Margin="0 0 0 5"/>
                            
                            <CheckBox Content="{helpers:Localize Label_InvertResult}"
                                      TabIndex="17"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnPass.IsInvertResult, FallbackValue='False'}"/>
                        
                            <RadioButton Content="{helpers:Localize Label_Continue}"
                                         TabIndex="18"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CONTINUE, FallbackValue='False'}"/>

                            <RadioButton Content="{helpers:Localize Label_Repeat}"
                                         TabIndex="19"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=REPEAT, FallbackValue='False'}"/>

                            <RadioButton Content="{helpers:Localize Label_EndTest}"
                                         TabIndex="20"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=END_TEST, FallbackValue='False'}"/>
                            
                            <Grid ColumnDefinitions="Auto,*,5"
                                  ColumnSpacing="10">
                                
                                <RadioButton Grid.Column="0"
                                             Content="{helpers:Localize Label_JumpTo}"
                                             TabIndex="21"
                                             GroupName="PassAction"
                                             IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}"/>

                                <ComboBox Grid.Column="1"
                                          TabIndex="22"
                                          Classes="JumpTarget"
                                          ItemsSource="{Binding JumpTargets}"
                                          SelectedItem="{Binding SelectedPassJumpTarget, Mode=TwoWay}"
                                          IsEnabled="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}"
                                                       ToolTip.Tip="{Binding Display}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            
                            <RadioButton Content="{helpers:Localize Label_ShowComment}"
                                         TabIndex="23"
                                         GroupName="PassAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SHOW_COMMENT, FallbackValue='False'}"/>
                            
                            <CheckBox Content="{helpers:Localize Label_IncludeResult}"
                                      TabIndex="24"
                                      Margin="25 0 0 0"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnPass.IsIncludeResult, FallbackValue='False'}"
                                      IsEnabled="{Binding TestStepViewModel.TestStep.OnPass.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SHOW_COMMENT, FallbackValue='False'}"/>
                            
                        </StackPanel>
                    
                        <StackPanel Grid.Column="1"
                                    Spacing="10">
                        
                            <TextBlock Text="{helpers:Localize Header_FailAction}"
                                       Classes="Large"
                                       Margin="0 0 0 5"/>
                            
                            <CheckBox Content="{helpers:Localize Label_InvertResult}"
                                      TabIndex="25"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnFail.IsInvertResult, FallbackValue='False'}"/>
                        
                            <RadioButton Content="{helpers:Localize Label_Continue}"
                                         TabIndex="26"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CONTINUE, FallbackValue='False'}"/>
                            
                            <RadioButton Content="{helpers:Localize Label_Repeat}"
                                         TabIndex="27"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=REPEAT, FallbackValue='False'}"/>

                            <RadioButton Content="{helpers:Localize Label_EndTest}"
                                         TabIndex="28"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=END_TEST, FallbackValue='False'}"/>
                            
                            <Grid ColumnDefinitions="Auto,*,5"
                                  ColumnSpacing="10">
                                
                                <RadioButton Grid.Column="0"
                                             Content="{helpers:Localize Label_JumpTo}"
                                             TabIndex="29"
                                             GroupName="FailAction"
                                             IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}"/>

                                <ComboBox Grid.Column="1"
                                          TabIndex="30"
                                          Classes="JumpTarget"
                                          ItemsSource="{Binding JumpTargets}"
                                          SelectedItem="{Binding SelectedFailJumpTarget, Mode=TwoWay}"
                                          IsEnabled="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JUMP_TO, FallbackValue='False'}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}"
                                                       ToolTip.Tip="{Binding Display}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            
                            <RadioButton Content="{helpers:Localize Label_ShowComment}"
                                         TabIndex="31"
                                         GroupName="FailAction"
                                         IsChecked="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SHOW_COMMENT, FallbackValue='False'}"/>
                            
                            <CheckBox Content="{helpers:Localize Label_IncludeResult}"
                                      TabIndex="32"
                                      Margin="25 0 0 0"
                                      IsChecked="{Binding TestStepViewModel.TestStep.OnFail.IsIncludeResult, FallbackValue='False'}"
                                      IsEnabled="{Binding TestStepViewModel.TestStep.OnFail.Mode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SHOW_COMMENT, FallbackValue='False'}"/>
                            
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>