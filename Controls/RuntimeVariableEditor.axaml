<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:helpers="clr-namespace:ATLab.Helpers"
             x:Class="ATLab.Controls.RuntimeVariableEditor"
             x:DataType="vm:RuntimeVariableEditorViewModel"
             Width="780">
    
    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            
            <TextBlock Text="{helpers:Localize Header_RuntimeVariables}"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border Grid.Row="1"
            CornerRadius="0 0 15 15"
            BorderThickness="2"
            BorderBrush="{DynamicResource OutlineColor}">
            
            <Grid RowDefinitions="Auto,*"
                  Margin="10"
                  RowSpacing="10">
                
                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="5">
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_AddVariable}"
                        Command="{Binding AddVariableCommand}"
                        Width="35"
                        Height="35">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Plus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="{helpers:Localize ToolTip_RemoveVariable}"
                        Command="{Binding RemoveVariableCommand}"
                        Width="35"
                        Height="35">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Minus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                        
                </StackPanel>
                
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RuntimeVariables}"
                          SelectedItem="{Binding SelectedVariable}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          BorderThickness="2"
                          BorderBrush="{DynamicResource OutlineColor}"
                          VerticalScrollBarVisibility="Auto">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                            <Setter Property="Fill" Value="{DynamicResource InfoColor}" />
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </DataGrid.Styles>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{helpers:Localize Header_VariableName}" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="{helpers:Localize Header_InitialValue}" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="200"/>
                    </DataGrid.Columns>
                    
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{helpers:Localize Menu_Add}" Command="{Binding AddVariableCommand}"/>
                            <MenuItem Header="{helpers:Localize Menu_Remove}" Command="{Binding RemoveVariableCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>