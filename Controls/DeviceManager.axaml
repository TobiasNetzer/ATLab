<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Controls.DeviceManager"
             x:DataType="vm:DeviceManagerViewModel"
             Width="780">

    <Grid ColumnDefinitions="250,*" RowDefinitions="Auto,*">
        
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            <TextBlock Text="Device Manager"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource TabItemsBackgroundColor}"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2"
                CornerRadius="0 0 0 15">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                
                <StackPanel Spacing="10"
                            Margin="10">
                    
                    <StackPanel Spacing="2"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Device Name"/>
                        <TextBox Text="{Binding SelectedDevice.Name}"
                                 Width="210"/>
                    </StackPanel>
                    
                    <CheckBox Content="Include in Test Report"
                              IsChecked="{Binding SelectedDevice.IsIncludeInReport}"/>
                    
                    <StackPanel Spacing="2"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding SelectedDevice.IsIncludeInReport}">
                        <TextBlock Text="Identification Query"/>
                        <TextBox Text="{Binding SelectedDevice.IdentificationQuery}"
                                 Width="210"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="2"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Interface"/>
                        <ComboBox ItemsSource="{Binding AvailableDeviceTypes}"
                                  SelectedItem="{Binding SelectedDevice.Type}"
                                  DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                                  Width="210"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="2"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Port"
                                   IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SERIAL, FallbackValue='TRUE'}"/>
                        
                        <TextBlock Text="Resource"
                                   IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VISA, FallbackValue='FALSE'}"/>
                        
                        <TextBlock Text="IP-Address"
                                   IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TCP_IP, FallbackValue='FALSE'}"/>

                        <StackPanel Spacing="5" Orientation="Horizontal">

                            <StackPanel>
                                <StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5"
                                                IsEnabled="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SERIAL}"
                                                IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SERIAL}">
                                        
                                        <TextBox
                                            Width="120"
                                            Text="{Binding SelectedDevice.ResourceString}" />
                                        
                                        <ComboBox
                                            Width="40"
                                            ItemsSource="{Binding AvailableSerialPorts}"
                                            SelectedItem="{Binding SelectedSerialPort}" />


                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5"
                                                IsEnabled="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VISA, FallbackValue='FALSE'}"
                                                IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VISA, FallbackValue='FALSE'}">
                                        
                                        <TextBox
                                            Width="120"
                                            Text="{Binding SelectedDevice.ResourceString}" />
                                        
                                        <ComboBox
                                            Width="40"
                                            ItemsSource="{Binding AvailableVisaResources}"
                                            SelectedItem="{Binding SelectedVisaResource}" />

                                    </StackPanel>

                                    <TextBox Text="{Binding SelectedDevice.ResourceString}"
                                             Width="210"
                                             IsEnabled="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TCP_IP, FallbackValue='FALSE'}"
                                             IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TCP_IP, FallbackValue='FALSE'}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Button
                                Background="{DynamicResource ButtonBackground}"
                                Classes="Icon"
                                ToolTip.Tip="Reload resources"
                                Command="{Binding RefreshResourcesCommand}"
                                IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='SERIAL,VISA'}"
                                Width="35"
                                Height="35">
                                <shadui:ButtonAssist.Icon>
                                    <ContentControl Content="{LucideIconContent RotateCcw}"/>
                                </shadui:ButtonAssist.Icon>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SERIAL}"
                                Spacing="10">
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Baud Rate"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableBaudRates}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.BaudRate}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Data Bits"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableDataBits}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.DataBits}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Parity"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableParities}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.Parity}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Stop Bits"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableStopBits}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.StopBits}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Handshake"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableHandshakes}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.Handshake}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Termination Character"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableSerialTermination}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.SerialTerminationMode}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Framing Mode"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableFramingModes}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.FramingMode}"
                                      DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding SelectedDevice.Configuration.FramingMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TIMEOUT_BASED}">
                            <TextBlock Text="Timeout (ms)"/>
                            <NumericUpDown Width="210"
                                           Minimum="10"
                                           Maximum="10000"
                                           HorizontalAlignment="Left"
                                           FormatString="0"
                                           Value="{Binding FramingTimeoutMsString}"/>
                        </StackPanel>
                        
                    </StackPanel>
                    
                    <StackPanel IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VISA, FallbackValue='FALSE'}"
                                Spacing="10">
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Timeout (ms)"/>
                            <NumericUpDown Width="210"
                                           Minimum="10"
                                           Maximum="10000"
                                           HorizontalAlignment="Left"
                                           FormatString="0"
                                           Value="{Binding VisaTimeoutMsString}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Termination Character"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableVisaTerminations}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.VisaTerminationMode}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel IsVisible="{Binding SelectedDevice.Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TCP_IP, FallbackValue='FALSE'}"
                                Spacing="10">
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Port"/>
                            <NumericUpDown Width="210"
                                           Minimum="1"
                                           Maximum="65535"
                                           HorizontalAlignment="Left"
                                           FormatString="0"
                                           Value="{Binding SelectedDevice.Configuration.TcpPort}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Timeout (ms)"/>
                            <NumericUpDown Width="210"
                                           Minimum="10"
                                           Maximum="10000"
                                           HorizontalAlignment="Left"
                                           FormatString="0"
                                           Value="{Binding TcpTimeoutMsString}"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="2"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Termination Character"/>
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableTcpTerminations}"
                                      SelectedItem="{Binding SelectedDevice.Configuration.TcpTerminationMode}"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource TabItemsBackgroundColor}"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2"
                CornerRadius="0 0 15 0"
                Padding="10">

            <Grid RowDefinitions="Auto, *" RowSpacing="10">
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Add new device"
                        Command="{Binding AddDeviceCommand}"
                        Width="35"
                        Height="35">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Plus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Remove device"
                        Command="{Binding RemoveDeviceCommand}"
                        Width="35"
                        Height="35">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Minus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                </StackPanel>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="2"
                          BorderBrush="{DynamicResource OutlineColor}"
                          VerticalScrollBarVisibility="Auto">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow:selected">
                            <Setter Property="Background" Value="{DynamicResource InfoColor}"/>
                        </Style>
                    </DataGrid.Styles>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Interface" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Resource" Binding="{Binding ResourceString}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>