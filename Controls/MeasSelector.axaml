<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.MeasSelector"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:MeasChannelViewModel"
             Width="500">
    
    <UserControl.Styles>
        <Style Selector="Border.Header">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.Header.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
        
        <Style Selector="ComboBox /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="{Binding $parent[ComboBox].Bounds.Width}"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel>
        <Border Classes="Header"
                Classes.expanded="{Binding IsExpanded}"
                Background="{DynamicResource SystemBaseLowColor}"
                Padding="10"
                Margin="0">
            <DockPanel>
                <TextBlock Text="Matrix Channels"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="5">
                                <Grid>
                                    <TextBlock Text="&#xE70D;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="&#xE70E;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="0 0 15 15"
            BorderThickness="2"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            IsVisible="{Binding IsExpanded}">
            
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="20"
                        Margin="10">
                <StackPanel>
                    <TextBlock Text="Matrix H"
                               FontSize="16"/>
                    
                    <ComboBox ItemsSource="{Binding CustomChannelNamesWithOffMember}"
                              SelectedIndex="{Binding IsSelectedH, Mode=TwoWay}"
                              Width="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="ChannelIndex" FallbackValue=""/>
                                            <Binding Path="ChannelName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <Button Content="&#xF1CB;"
                        FontFamily="{StaticResource FluentIconsFont}"
                        FontSize="20"
                        ToolTip.Tip="Swap channels"
                        VerticalAlignment="Bottom"
                        Command="{Binding ToggleChannelsCommand}"/>
                
                <StackPanel>
                    <TextBlock Text="Matrix L"
                               FontSize="16"/>
                
                    <ComboBox ItemsSource="{Binding CustomChannelNamesWithOffMember}"
                              SelectedIndex="{Binding IsSelectedL, Mode=TwoWay}"
                              Width="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="ChannelIndex" FallbackValue=""/>
                                            <Binding Path="ChannelName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
