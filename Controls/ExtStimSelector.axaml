<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.ExtStimSelector"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:ExtStimChannelViewModel"
             Width="500">
    
    <Design.DataContext>
        <vm:ExtStimChannelViewModel />
    </Design.DataContext>
    
    <Border Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="15"
            Margin="10">
        
        <StackPanel>
            <Border Background="{DynamicResource SystemBaseLowColor}"
                    CornerRadius="15"
                    Padding="10"
                    Margin="0">
                <DockPanel>
                    <TextBlock Text="External Stimulation Channels"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>

                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  DockPanel.Dock="Right"
                                  HorizontalAlignment="Right">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border Background="Transparent" Padding="5">
                                    <Grid>
                                        <TextBlock Text="&#xE70D;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="24"
                                                   IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                        <TextBlock Text="&#xE70E;" 
                                                   FontFamily="{StaticResource FluentIconsFont}"
                                                   FontSize="24"
                                                   IsVisible="{Binding IsExpanded}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </DockPanel>
            </Border>
            
            <ItemsControl ItemsSource="{Binding ExtStimChannels}"
                          IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=controls:ExtStimSelector}}"
                                     HorizontalAlignment="Center"
                                     ColumnSpacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RelayChannelViewModel">
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Margin="5"
                                  Width="200">
                            <CheckBox.Content>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="ChannelIndex"/>
                                    <Binding Path="CustomName.ChannelName"/>
                                </MultiBinding>
                            </CheckBox.Content>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>