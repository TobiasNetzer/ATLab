<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:controls="clr-namespace:ATLab.Controls"
             x:Class="ATLab.Controls.ShellCommandEditor"
             x:DataType="controls:ShellCommandEditor"
             Width="500">

    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        
        <Border Classes="WithDynamicCorner"
                Classes.expanded="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.IsExpanded}"
                Background="{DynamicResource OutlineColor}"
                Padding="10">

            <DockPanel>
                <TextBlock Text="Shell Command"
                           Classes="h4"
                           VerticalAlignment="Center"/>
                
                <Button Command="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.ToggleExpandedCommand}"
                        Classes="Ghost"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                    <shadui:ButtonAssist.Icon>
                        <Grid>
                            <ContentControl Content="{LucideIconContent ChevronDown}"
                                            IsVisible="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                            <ContentControl Content="{LucideIconContent ChevronUp}"
                                            IsVisible="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.IsExpanded}"/>
                        </Grid>
                    </shadui:ButtonAssist.Icon>
                </Button>
            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource TabItemsBackgroundColor}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                IsVisible="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.IsExpanded}">

            <StackPanel Margin="10" Spacing="15">

                <TextBox Text="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.ShellCommand.Command}"/>

                <DockPanel LastChildFill="False">
                    
                    <CheckBox Content="Direct Launch"
                              IsChecked="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.ShellCommand.IsDirectLaunch, Mode=TwoWay}"
                              DockPanel.Dock="Left"/>
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                DockPanel.Dock="Right">
                        
                        <TextBlock Text="Window Behavior"
                                   Classes="Small"
                                   VerticalAlignment="Center"/>

                        <ComboBox ItemsSource="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.CommandOptions}"
                                  Width="130"
                                  SelectedItem="{Binding $parent[controls:ShellCommandEditor].ShellCommandEditorVm.ShellCommand.Option}"
                                  DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        
                    </StackPanel>
                    
                </DockPanel>

            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
