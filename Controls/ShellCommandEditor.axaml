<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:models="clr-namespace:ATLab.Models"
             x:Class="ATLab.Controls.ShellCommandEditor"
             x:DataType="vm:ShellCommandEditorViewModel"
             Width="500">
    
    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
    </UserControl.Styles>
    
    <StackPanel>
        
        <Border Classes="WithDynamicCorner"
                Classes.expanded="{Binding IsExpanded}"
                Background="{DynamicResource SystemBaseLowColor}"
                Padding="10"
                Margin="0">
            <DockPanel>
                <TextBlock Text="Shell Command Editor"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              DockPanel.Dock="Right"
                              HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <Border Background="Transparent" Padding="5">
                                <Grid>
                                    <TextBlock Text="&#xE70D;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="&#xE70E;" 
                                               FontFamily="{StaticResource FluentIconsFont}"
                                               FontSize="18"
                                               IsVisible="{Binding IsExpanded}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource SystemChromeLowColor}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                IsVisible="{Binding IsExpanded}">
            
            <StackPanel Margin="10"
                        Spacing="15">
                    
                <TextBox Text="{Binding ShellCommand.Command}"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Window Options:"
                               VerticalAlignment="Center"/>
                    
                    <ComboBox ItemsSource="{Binding EvaluationSources}"
                              MinWidth="100"
                              SelectedItem="{Binding ShellCommand.Option, FallbackValue=''}"
                              DisplayMemberBinding="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                              TabIndex="6"/>
                </StackPanel>
                
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>