<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             xmlns:models="clr-namespace:ATLab.Models"
             xmlns:controls="clr-namespace:ATLab.Controls"
             x:Class="ATLab.Controls.ScriptSelector"
             x:DataType="controls:ScriptSelector"
             Width="500">


    <UserControl.Styles>
        <Style Selector="Border.WithDynamicCorner">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style Selector="Border.WithDynamicCorner.expanded">
            <Setter Property="CornerRadius" Value="15 15 0 0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        
        <Border Classes="WithDynamicCorner"
                Classes.expanded="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.IsExpanded}"
                Background="{DynamicResource OutlineColor}"
                Padding="10">

            <DockPanel>

                <TextBlock Text="Script Configuration"
                           Classes="h4"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <Button Command="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.ToggleExpandedCommand}"
                        Classes="Ghost"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                    <shadui:ButtonAssist.Icon>
                        <Grid>
                            <ContentControl Content="{LucideIconContent ChevronDown}"
                                            IsVisible="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.IsExpanded, Converter={StaticResource InverseBoolConverter}}"/>
                            <ContentControl Content="{LucideIconContent ChevronUp}"
                                            IsVisible="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.IsExpanded}"/>
                        </Grid>
                    </shadui:ButtonAssist.Icon>
                </Button>

            </DockPanel>
        </Border>
        
        <Border Background="{DynamicResource TabItemsBackgroundColor}"
                CornerRadius="0 0 15 15"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                IsVisible="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.IsExpanded}">

            <StackPanel Margin="10" Spacing="15">
                
                <StackPanel Spacing="2">
                    <TextBlock Text="Target Device"/>

                    <DockPanel>
                        
                        <Button
                            Background="{DynamicResource ButtonBackground}"
                            Classes="Icon"
                            ToolTip.Tip="Remove selected device"
                            Command="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.RemoveDeviceCommand}"
                            Width="35"
                            Height="35"
                            Margin="5 0 0 0"
                            DockPanel.Dock="Right">
                            <shadui:ButtonAssist.Icon>
                                <ContentControl Content="{LucideIconContent X}"/>
                            </shadui:ButtonAssist.Icon>
                        </Button>

                        <ComboBox ItemsSource="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.Devices}"
                                  SelectedItem="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.SelectedDevice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">

                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Device">
                                    <TextBlock>
                                        <Run Text="{Binding Name}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding ResourceString}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </DockPanel>
                </StackPanel>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="Script"/>

                    <DockPanel>
                        
                        <Button
                            Background="{DynamicResource ButtonBackground}"
                            Classes="Icon"
                            ToolTip.Tip="Remove selected script"
                            Command="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.RemoveScriptCommand}"
                            Width="35"
                            Height="35"
                            Margin="5 0 0 0"
                            DockPanel.Dock="Right">
                            <shadui:ButtonAssist.Icon>
                                <ContentControl Content="{LucideIconContent X}"/>
                            </shadui:ButtonAssist.Icon>
                        </Button>

                        <ComboBox ItemsSource="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.Scripts}"
                                  SelectedItem="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.SelectedScript, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">

                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScriptViewModel">
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip.Tip="{Binding Description}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </DockPanel>
                </StackPanel>
                
                <DataGrid ItemsSource="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.ScriptVariables}"
                          IsVisible="{Binding $parent[controls:ScriptSelector].ScriptSelectorVm.ScriptVariables,
                                              Converter={x:Static ObjectConverters.IsNotNull}}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          BorderBrush="{DynamicResource OutlineColor}"
                          BorderThickness="2"
                          MaxHeight="200">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow:selected">
                            <Setter Property="Background" Value="{DynamicResource InfoColor}"/>
                        </Style>
                    </DataGrid.Styles>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variable"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="*"/>

                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value}"
                                            Width="*"/>
                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </StackPanel>

</UserControl>
