<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.Controls.TestHardwareInterface"
             Width="1200">
    
    <Grid RowDefinitions="Auto,*">
            
        <Border Grid.Row="0"
                Background="{DynamicResource OutlineColor}"
                CornerRadius="15 15 0 0"
                Padding="10">
            <TextBlock Text="Test Hardware Interface"
                       Classes="h4"
                       HorizontalAlignment="Center"/>
        </Border>
            
        <Border Grid.Row="1"
                Background="{DynamicResource TabItemsBackgroundColor}"
                CornerRadius="0 0 15 15"
                BorderBrush="{DynamicResource OutlineColor}"
                BorderThickness="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image Source="avares://ATLab/Assets/Hardware_Interface.png"
                           Width="1150"
                           Margin="0,10,0,10"/>
                </Grid>
            </ScrollViewer>

        </Border>
    </Grid>
    
</UserControl>
