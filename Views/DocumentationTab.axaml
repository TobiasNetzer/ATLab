<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:DocumentationTabViewModel"
             x:Class="ATLab.Views.DocumentationTab">
    
            <controls:ProjectDocumentationViewer Margin="10" DataContext="{Binding ProjectDocumentationViewModel}"/>
    
</UserControl>
