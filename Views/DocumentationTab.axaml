<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:DocumentationTabViewModel"
             x:Class="ATLab.Views.DocumentationTab">
    
            
            
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    
                <Grid ColumnDefinitions="*, Auto, Auto, *"
                      RowDefinitions="Auto, *"
                      Margin="0 10"
                      ColumnSpacing="10"
                      RowSpacing="10">
            
                    <controls:ProjectDocumentationViewer Grid.Column="1"
                                                         Grid.Row="0"
                                                         Grid.RowSpan="2"
                                                         DataContext="{Binding ProjectDocumentationViewModel}"/>
                    
                    <controls:DutInfoPanel Grid.Column="2"
                                           Grid.Row="0"
                                           DataContext="{Binding DeviceUnderTestInfoPanelViewModel}"/>
            
                </Grid>
            </ScrollViewer>
</UserControl>
