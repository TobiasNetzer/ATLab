<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ATLab.ViewModels"
        x:Class="ATLab.Views.SerialNumberEntryWindow"
        x:DataType="vm:SerialNumberEntryWindowViewModel"
        Title="Serial Number"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight">
        
    <Grid Margin="10"
            RowDefinitions="Auto,Auto,Auto">

        <TextBlock Text="Enter Serial Number"
                        Margin="0,0,0,2" />

        <TextBox Grid.Row="1"
                 x:Name="SerialNoTextBox"
                 Width="300"
                 MaxLength="100"
                 Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Spacing="10">

            <Button Content="Start"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Width="145"
                    Command="{Binding OkCommand}"
                    IsEnabled="{Binding IsOkEnabled}"
                    IsDefault="True"/>

            <Button Content="Cancel"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Width="145"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
            
        </StackPanel>
    </Grid>
</Window>
