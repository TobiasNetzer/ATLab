<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:DataType="vm:HardwareTabViewModel"
             x:Class="ATLab.Views.HardwareTab">
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    
        <Grid RowDefinitions="auto, auto, *"
              Margin="10"
              RowSpacing="10">
            <controls:TestHardwareInfo Grid.Row="0"
                                       DataContext="{Binding TestHardwareInfoViewModel}"/> 
            <controls:TestHardwareInterface Grid.Row="1"/>  
        </Grid>
    </ScrollViewer>
</UserControl>
