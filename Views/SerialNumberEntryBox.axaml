<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ATLab.ViewModels"
        x:Class="ATLab.Views.SerialNumberEntryBox"
        x:DataType="vm:SerialNumberEntryBoxViewModel"
        Title="Serial Number"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight">
        
    <Grid Margin="10"
            RowDefinitions="Auto,Auto,Auto">

        <TextBlock Text="Enter serial number:"
                        Margin="0,0,0,10" />

        <TextBox Grid.Row="1"
                        Width="300"
                        Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

            <Button Content="Start"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    MinWidth="100"
                    Command="{Binding OkCommand}"
                    IsDefault="True"
                    Margin="0,0,20,0" />

            <Button Content="Cancel"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    MinWidth="100"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" 
                    Margin="20,0,0,0"/>
            
        </StackPanel>
    </Grid>
</Window>
