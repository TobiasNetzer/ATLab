<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ATLab.ViewModels"
        x:Class="ATLab.Views.MessageBox"
        x:DataType="vm:MessageBoxViewModel"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight">
    
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Command="{Binding OkCommand}" Content="OK" Width="80" HorizontalContentAlignment="Center"/>
            <Button Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}" Content="Cancel" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
