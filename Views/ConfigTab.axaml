<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.ConfigTab"
             x:DataType="vm:ConfigTabViewModel">
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*, *"
              RowDefinitions="*, *"
              Margin="10">
                
            <controls:CustomChannelNameSetter
                Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                DataContext="{Binding TestHardwareRelayChannels}"
                Margin="0 0 5 0"/>
            
            <controls:DeviceManager 
                Grid.Column="1"
                Grid.Row="0"
                HorizontalAlignment="Left"
                DataContext="{Binding DeviceManager}"
                Margin="5 0 0 10"/>
        
            <controls:ProjectSettings 
                Grid.Column="1"
                Grid.Row="1"
                HorizontalAlignment="Left"
                DataContext="{Binding ProjectSettingsViewModel}"
                Margin="5 0 0 0"/>
                
        </Grid>
    </ScrollViewer>
</UserControl>