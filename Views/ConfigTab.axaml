<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.ConfigTab"
             x:DataType="vm:ConfigTabViewModel">
    
    <Grid ColumnDefinitions="*, 50, *"
          RowDefinitions="*, auto"
          Margin="10">
            
        <controls:CustomChannelNameSetter
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Right"
            DataContext="{Binding TestHardwareRelayChannels}"
            Margin="0 0 0 20"/>
        
        <controls:SerialDeviceManager
            Grid.Column="2"
            Grid.Row="0"
            HorizontalAlignment="Left"
            DataContext="{Binding SerialDeviceManager}"
            Margin="0 0 0 20"/>
        
        <StackPanel
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center" >
            <TextBlock Text="Tolerance (%):"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <NumericUpDown Value="{Binding ToleranceValue}"
                           Minimum="0"
                           Maximum="100"
                           Width="120"/>
        </StackPanel>
            
    </Grid>
</UserControl>