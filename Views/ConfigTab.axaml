<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.ConfigTab"
             x:DataType="vm:ConfigTabViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="20">
            
            <controls:CustomChannelNameSetter
                DataContext="{Binding TestHardwareRelayChannels}"
                HorizontalAlignment="Center"/>
            
            <controls:SerialDeviceManager
                DataContext="{Binding SerialDeviceManager}"/>
            
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" >
                <TextBlock Text="Tolerance (%):"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <NumericUpDown Value="{Binding ToleranceValue}"
                               Minimum="0"
                               Maximum="100"
                               Width="120"/>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>