<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.LabTab"
             x:DataType="vm:LabTabViewModel">

    <Design.DataContext>
        <vm:LabTabViewModel />
    </Design.DataContext>

    <StackPanel>
        
        <controls:MeasSelector
            DataContext="{Binding TestConfiguration.MeasChannelViewModel}"
            HorizontalAlignment="Left"
            Margin="5"/>
        
        <controls:StimSelector 
            DataContext="{Binding TestConfiguration.StimChannelViewModel}"
            HorizontalAlignment="Left"
            GridColumns="2"
            Margin="5"/>
        
        <controls:ExtStimSelector 
            DataContext="{Binding TestConfiguration.ExtStimChannelViewModel}"
            HorizontalAlignment="Left"
            GridColumns="2"
            Margin="5"/>
        
        <Button
            Content="Set Relay State"
            Command="{Binding UpdateTestHardwareRelayStatesCommand}"
            Margin="5"/>
            
    </StackPanel>
</UserControl>