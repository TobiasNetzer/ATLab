<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:controls="clr-namespace:ATLab.Controls"
             xmlns:behaviors="clr-namespace:ATLab.Behaviors"
             xmlns:vm="clr-namespace:ATLab.ViewModels"
             x:Class="ATLab.Views.TestingTab"
             x:DataType="vm:TestingTabViewModel">
        
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="auto,*,auto,auto">
        
        <Border Grid.Column="0" Grid.Row="0" 
                BorderBrush="{DynamicResource OutlineColor}"
                Background="{DynamicResource TabItemsBackgroundColor}"
                BorderThickness="2"
                CornerRadius="10"
                Margin="10 10 10 0">
            
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal"
                            Margin="5"
                            Spacing="5">
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="New file"
                        Command="{Binding NewFileCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent FilePlusCorner}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Open file"
                        Command="{Binding LoadFileWithDialogCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent FolderOpen}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Save file"
                        Command="{Binding SaveFileCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Save}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Save file as"
                        Command="{Binding SaveFileAsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent SavePen}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Add a new test step"
                        Command="{Binding AddTestStepCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Plus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Remove selected test steps"
                        Command="{Binding RemoveTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Minus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Move selected test step up"
                        Command="{Binding MoveStepUpCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowUp}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Move selected test step down"
                        Command="{Binding MoveStepDownCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowDown}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Duplicate selected test steps"
                        Command="{Binding DuplicateTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent CopyPlus}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Cut selected test steps"
                        Command="{Binding CutTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Scissors}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Copy selected test steps"
                        Command="{Binding CopyTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Copy}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Paste test steps"
                        Command="{Binding PasteTestStepsCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ClipboardPaste}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Execute single step"
                        Command="{Binding StartSingleStepTestCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartSingleStepBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent CornerDownLeft}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Start test execution from selected step"
                        Command="{Binding StartTestFromSelectionCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartFromStepBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent ArrowDownFromLine}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Start continuous test execution"
                        Command="{Binding StartTestRepeatCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartRepeatTestBusy}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                    <shadui:ButtonAssist.Icon>
                        <ContentControl Content="{LucideIconContent Repeat}"/>
                    </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Start test execution"
                        Command="{Binding StartTestCommand}"
                        shadui:ButtonAssist.ShowProgress="{Binding StartTestBusy}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Play}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Stop test execution"
                        Command="{Binding CancelTestCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Square}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>

                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               Background="{DynamicResource MutedColor}"/>
                    
                    <Button
                        Background="{Binding IsDebugMode, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="Enable debug mode"
                        Command="{Binding ToggleDebugModeCommand}"
                        IsEnabled="{Binding IsDevelopmentMode}"
                        IsVisible="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Bug}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{DynamicResource ButtonBackground}"
                        Classes="Icon"
                        ToolTip.Tip="Advance single step"
                        Command="{Binding RequestSingleStepContinueCommand}"
                        IsVisible="{Binding IsDevelopmentMode}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent StepForward}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Separator Width="2"
                               Height="25"
                               Margin="5 0 5 0"
                               CornerRadius="1"
                               IsVisible="{Binding IsDevelopmentMode}"
                               Background="{DynamicResource MutedColor}"/>
                    
                    <Button
                        Background="{Binding IsShowMeasurementPanel, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="Show measurement panel"
                        Command="{Binding ToggleMeasurementPanelCommand}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent SearchAlert}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                    <Button
                        Background="{Binding IsDevelopmentMode, Converter={StaticResource ButtonEnabledConverter}}"
                        Classes="Icon"
                        ToolTip.Tip="Enable development mode"
                        Command="{Binding ToggleDevelopmentModeCommand}"
                        IsEnabled="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}"
                        Width="40"
                        Height="40">
                        <shadui:ButtonAssist.Icon>
                            <ContentControl Content="{LucideIconContent Construction}"/>
                        </shadui:ButtonAssist.Icon>
                    </Button>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <DataGrid Grid.Column="0" Grid.Row="1"
                  x:Name="TestStepPresenter"
                  ItemsSource="{Binding TestSteps}"
                  SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                  Margin="10"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Extended"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource OutlineColor}"
                  Background="{DynamicResource TabItemsBackgroundColor}"
                  behaviors:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedSteps}"
                  IsEnabled="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}">
            
            <DataGrid.Styles>
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="{DynamicResource InfoColor}" />
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </DataGrid.Styles>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="No." Binding="{Binding TestStep.Number}" MinWidth="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding TestStep.Name}" Width="*" MinWidth="200" />
                
                <DataGridTemplateColumn Header="Lower Limit" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TestStepViewModel">
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                        <Binding Path="TestStep.LowerLimit"/>
                                        <Binding Path="TestStep.Unit"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Nominal Value" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TestStepViewModel">
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                        <Binding Path="TestStep.NominalValue"/>
                                        <Binding Path="TestStep.Unit"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Upper Limit" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TestStepViewModel">
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource UnitFormatConverter}">
                                        <Binding Path="TestStep.UpperLimit"/>
                                        <Binding Path="TestStep.Unit"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Measured Value" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:TestStepViewModel">
                            <TextBlock Text="{Binding Result}" 
                                       Foreground="{Binding IsPassed, Converter={StaticResource ResultBrushConverter}}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Deviation" Binding="{Binding Deviation}" MinWidth="100" />
                <DataGridTemplateColumn Header="Result" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="15" Height="15"
                                   Source="{Binding IsPassed, Converter={StaticResource PassFailConverter}}"
                                   IsVisible="{Binding IsExecuted}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        
            <DataGrid.ContextMenu>
                <ContextMenu IsEnabled="{Binding IsDevelopmentMode}">
                    <MenuItem Header="Add" Command="{Binding AddTestStepCommand}"/>
                    <MenuItem Header="Remove" Command="{Binding RemoveTestStepsCommand}"/>
                    <MenuItem Header="Move Up" Command="{Binding MoveStepUpCommand}"/>
                    <MenuItem Header="Move Down" Command="{Binding MoveStepDownCommand}"/>
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateTestStepsCommand}"/>
                    <MenuItem Header="Cut" Command="{Binding CutTestStepsCommand}"/>
                    <MenuItem Header="Copy" Command="{Binding CopyTestStepsCommand}"/>
                    <MenuItem Header="Paste" Command="{Binding PasteTestStepsCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            
            <DataGrid.KeyBindings>
                <KeyBinding Gesture="Insert"
                            Command="{Binding AddTestStepCommand}" />
                <KeyBinding Gesture="Delete"
                            Command="{Binding RemoveTestStepsCommand}" />
                <KeyBinding Gesture="Ctrl+C"
                            Command="{Binding CopyTestStepsCommand}" />
                <KeyBinding Gesture="Ctrl+X"
                            Command="{Binding CutTestStepsCommand}" />
                <KeyBinding Gesture="Ctrl+V"
                            Command="{Binding PasteTestStepsCommand}" />
            </DataGrid.KeyBindings>
            
        </DataGrid>
        
        <Border Grid.Column="0" Grid.Row="2"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                Background="{DynamicResource TabItemsBackgroundColor}"
                CornerRadius="10"
                Margin="10 0 10 10"
                IsVisible="{Binding IsShowMeasurementPanel}">
            
            
            <controls:MeasurementPanel
                LowerLimit="{Binding SelectedStep.TestStep.LowerLimit}"
                UpperLimit="{Binding SelectedStep.TestStep.UpperLimit}"
                MeasuredValue="{Binding SelectedStep.ResultNoFormatting}"
                Unit="{Binding SelectedStep.TestStep.Unit}"
                Valid="{Binding SelectedStep.IsPassed}"/>
            
        </Border>
        
        <Border Grid.Column="0" Grid.Row="3"
                BorderThickness="2"
                BorderBrush="{DynamicResource OutlineColor}"
                Background="{DynamicResource TabItemsBackgroundColor}"
                CornerRadius="10"
                Margin="10 0 10 10">
            
            <Grid ColumnDefinitions="*,*,*,*,*"
                  RowDefinitions="Auto,10,*"
                  Margin="10 10 10 10">

            <ProgressBar Grid.Column="0"
                         Grid.ColumnSpan="5"
                         Grid.Row="0" 
                         Minimum="0"
                         Maximum="100"
                         Height="40"
                         CornerRadius="5"
                         Value="{Binding TestProgress}"
                         Background="{DynamicResource OutlineColor}"
                         Foreground="{Binding TestStatus, Converter={StaticResource TestStatusToBrushConverter}}">
                
                <ProgressBar.Styles>
                    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </ProgressBar.Styles>
                
                <ProgressBar.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Value"
                                          Duration="{Binding AnimationDuration}">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </ProgressBar.Transitions>
                
            </ProgressBar>
            
            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RUNNING}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Running Test: {0} / {1}">
                        <Binding Path="SelectedStep.TestStep.Number" FallbackValue="" />
                        <Binding Path="TestSteps.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            
            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="Test Passed" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PASSED}"/>
            
            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="Test Failed" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FAILED}"/>
            
            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Grid.Row="0"
                       Text="Test Cancelled" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="24"
                       IsVisible="{Binding TestStatus, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CANCELLED}"/>
            
            <TextBlock Grid.Column="0"
                       Grid.Row="2"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Text="{Binding SerialNumber, StringFormat='S/N: {0}'}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding SerialNumber}"/>
            
            <TextBlock Grid.Column="1"
                       Grid.Row="2"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       MinWidth="200"
                       Text="{Binding TestDuration, StringFormat='Test Duration: {0}'}"/>
            
            <TextBlock Grid.Column="2"
                       Grid.Row="2"
                       Classes.error="{Binding NumberFailedSteps}"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Text="{Binding NumberFailedSteps, StringFormat='Failed Steps: {0}'}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.error">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
            
            <TextBlock Grid.Column="3"
                       Grid.Row="2"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Passed Tests: {0}/{1} ({2}%)">
                        <Binding Path="NumberPassedTests"/>
                        <Binding Path="NumberRunTests"/>
                        <Binding Path="PassedPercentage"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            
            <TextBlock Grid.Column="4"
                       Grid.Row="2"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Right"
                       Text="{Binding User, StringFormat='User: {0}'}"/>
            
        </Grid>
            
        </Border>
        
        <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                      Margin="0 10 0 10"
                      IsVisible="{Binding IsDevelopmentMode}">
            <StackPanel HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0 0 10 0"
                        IsEnabled="{Binding TestStatus, Converter={StaticResource InvertedEnumToBoolConverter}, ConverterParameter=RUNNING}">
                
                <controls:TestStepConfigurator 
                    DataContext="{Binding WorkspaceEditor.TestStepConfigurator}"/>

                <controls:ScriptSelector
                    ScriptSelectorVm="{Binding WorkspaceEditor.ScriptSelector}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SCRIPT}"/>
                
                <controls:CommandEditor
                    CommandEditorVm="{Binding WorkspaceEditor.CommandEditor}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=COMMAND}"/>
                
                <controls:ShellCommandEditor
                    ShellCommandEditorVm="{Binding WorkspaceEditor.ShellCommandEditor}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SHELL_COMMAND}"/>
                
                <controls:ExpressionEditor
                    ExpressionEditorVm="{Binding WorkspaceEditor.ExpressionEditor}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EXPRESSION}"/>

                <controls:FilePathEditor
                    FilePathEditorVm="{Binding WorkspaceEditor.FilePathEditor}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FILE}"/>
                
                <controls:TestInterfaceCommunication
                    TestInterfaceCommunicationVm="{Binding WorkspaceEditor.TestInterfaceCommunication}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=INTERFACE}"/>
                
                <controls:ResponseMaskEditor
                    ResponseMaskEditorVm="{Binding WorkspaceEditor.ResponseMaskEditor}"
                    IsVisible="{Binding SelectedStep.TestStep.EvaluationSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='SCRIPT, COMMAND, FILE, INTERFACE'}"/>
                
                <controls:MeasSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.MeasChannelViewModel}" />

                <controls:StimSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.StimChannelViewModel}"
                    GridColumns="2" />

                <controls:ExtStimSelector
                    DataContext="{Binding WorkspaceEditor.TestHardwareRelayChannels.ExtStimChannelViewModel}"
                    GridColumns="2" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>