<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ATLab.ViewModels"
        xmlns:views="clr-namespace:ATLab.Views"
        x:Class="ATLab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="1400"
        MinHeight="600">
    
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding LoadFileWithDialogCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelTestCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding StartTestCommand}" />
        <KeyBinding Gesture="F3" Command="{Binding StartSingleTestCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="FlyoutPresenter.LargeFlyout">
            <Setter Property="MaxWidth" Value="1000" />
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemChromeLowColor}"
                Height="50"
                VerticalAlignment="Top"/>
        
        <TabControl Grid.Row="0"
                    ItemsSource="{Binding Tabs}" 
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Padding="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.DataTemplates>
                <DataTemplate DataType="vm:TestingTabViewModel">
                    <views:TestingTab/>
                </DataTemplate>
                <DataTemplate DataType="vm:TestBenchViewModel">
                    <views:TestBenchTab/>
                </DataTemplate>
                <DataTemplate DataType="vm:ConfigTabViewModel">
                    <views:ConfigTab/>
                </DataTemplate>
                <DataTemplate DataType="vm:ScriptsManagerViewModel">
                    <views:ScriptTab/>
                </DataTemplate>
            </TabControl.DataTemplates>
        </TabControl>
        
        <Border Grid.Row="1"
        Background="{DynamicResource SystemChromeLowColor}"
        Height="40">

            <Grid ColumnDefinitions="Auto,*">
                
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            Margin="5">
                    
                    <Button
                        Background="{Binding HasErrors, Converter={StaticResource BoolToBrushConverter}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="&#xE7BA;" 
                                           FontFamily="{StaticResource FluentIconsFont}"
                                           FontSize="18"/>
                                <TextBlock Text="{Binding ErrorCount}"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button.Content>

                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft"
                                    IsOpen="{Binding IsErrorFlyoutOpen, Mode=TwoWay}"
                                    FlyoutPresenterClasses="LargeFlyout">
                                <ListBox ItemsSource="{Binding Errors}"
                                         Width="800"
                                         Height="500">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Text="Software is working without test hardware!"
                               FontSize="16"
                               Foreground="Red"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSimulation}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="&#xF08C;"
                        FontFamily="{StaticResource FluentIconsFont}"
                        FontSize="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10,0"
                        Command="{Binding ToggleThemeCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
