<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ATLab.ViewModels"
        xmlns:vmTabs="clr-namespace:ATLab.ViewModels.Tabs"
        xmlns:views="clr-namespace:ATLab.Views"
        x:Class="ATLab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ATLab"
        RequestedThemeVariant="Default">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding LoadFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="*,Auto">

        <DockPanel Grid.Row="0">

            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New" Command="{Binding NewFileCommand}"/>
                    <MenuItem Header="_Open" Command="{Binding LoadFileCommand}"/>
                    <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" />
                    <MenuItem Header="Save _As" Command="{Binding SaveFileAsCommand}" />
                    <MenuItem Header="_Exit"/>
                </MenuItem>

                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo"/>
                    <MenuItem Header="Redo"/>
                </MenuItem>
                
                <MenuItem Header="_Help">
                    <MenuItem Header="About" Command="{Binding OpenAboutWindowCommand}"/>
                </MenuItem>
            </Menu>
            
            <TabControl SelectedItem="{Binding SelectedTab}">
                <TabControl.DataTemplates>
                    <DataTemplate DataType="vmTabs:TestingTabViewModel">
                        <views:TestingTab/>
                    </DataTemplate>
                    <DataTemplate DataType="vmTabs:LabTabViewModel">
                        <views:LabTab/>
                    </DataTemplate>
                    <DataTemplate DataType="vmTabs:ConfigTabViewModel">
                        <views:ConfigTab/>
                    </DataTemplate>
                </TabControl.DataTemplates>
                <TabItem Header="{Binding TestingTab.Title}" Content="{Binding TestingTab}" />
                <TabItem Header="{Binding LabTab.Title}" Content="{Binding LabTab}" />
                <TabItem Header="{Binding ConfigTab.Title}" Content="{Binding ConfigTab}" />
            </TabControl>
        </DockPanel>
        
        <DockPanel Grid.Row="1" 
                   Background="{DynamicResource SystemChromeLowColor}"
                   Height="40">
            <Button DockPanel.Dock="Left"
                    
                    Background="{Binding HasErrors, Converter={StaticResource BoolToBrushConverter}}"
                    Height="30"
                    Margin="5">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource FluentIconsFont}"
                                   FontSize="18"/>
                        <TextBlock Text="{Binding ErrorCount}"
                                   FontSize="14"/>
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="Bottom"
                            IsOpen="{Binding IsErrorFlyoutOpen, Mode=TwoWay}">
                        <ListBox ItemsSource="{Binding Errors}"
                                 Width="300"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DockPanel>
    </Grid>
</Window>
