<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ATLab.App"
             xmlns:local="using:ATLab"
             xmlns:converters="clr-namespace:ATLab.Converters"
             xmlns:themes="clr-namespace:ShadUI;assembly=ShadUI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="WindowBackground">#FFFAFAFA</Color>
                    <Color x:Key="ButtonBackground">#FFF2F2F2</Color>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="WindowBackground">#FF27272A</Color>
                    <Color x:Key="ButtonBackground">#FF353535</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        
        <SolidColorBrush x:Key="EnabledBrush"
                         Color="{DynamicResource InfoColor}" />

        <SolidColorBrush x:Key="DisabledBrush"
                         Color="{DynamicResource ButtonBackground}" />
        
        <SolidColorBrush x:Key="TestStatusIdleBrush"
                         Color="{DynamicResource SecondaryColor}" />

        <SolidColorBrush x:Key="TestStatusRunningBrush"
                         Color="{DynamicResource InfoColor}" />

        <SolidColorBrush x:Key="TestStatusPassedBrush"
                         Color="#FF00C853" />

        <SolidColorBrush x:Key="TestStatusFailedBrush"
                         Color="#FFFF1744" />

        <SolidColorBrush x:Key="TestStatusCanceledBrush"
                         Color="Orange" />
        
        <SolidColorBrush x:Key="ResultValidBrush"
                         Color="#FF00C853" />

        <SolidColorBrush x:Key="ResultInvalidBrush"
                         Color="#FFFF1744" />

        <SolidColorBrush x:Key="ResultUnknownBrush"
                         Color="{DynamicResource SecondaryColor}" />
        
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <converters:UnitFormatConverter x:Key="UnitFormatConverter" />
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:InvertedEnumToBoolConverter x:Key="InvertedEnumToBoolConverter"/>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <converters:PassFailConverter x:Key="PassFailConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:NullableBoolToBoolConverter x:Key="NullableBoolToBoolConverter"/>
        <converters:EnumLocalizationConverter x:Key="EnumLocalizationConverter"/>
        <converters:BoolToValueConverter
            x:Key="ButtonEnabledConverter"
            TrueValue="{StaticResource EnabledBrush}"
            FalseValue="{StaticResource DisabledBrush}" />
        
        <converters:TestStatusToBrushConverter
            x:Key="TestStatusToBrushConverter"
            IdleBrush="{StaticResource TestStatusIdleBrush}"
            RunningBrush="{StaticResource TestStatusRunningBrush}"
            PassedBrush="{StaticResource TestStatusPassedBrush}"
            FailedBrush="{StaticResource TestStatusFailedBrush}"
            CanceledBrush="{StaticResource TestStatusCanceledBrush}" />
        
        <converters:ResultBrushConverter
            x:Key="ResultBrushConverter"
            ValidBrush="{StaticResource ResultValidBrush}"
            InvalidBrush="{StaticResource ResultInvalidBrush}"
            UnknownBrush="{StaticResource ResultUnknownBrush}" />
    </Application.Resources>
    
    <Application.Styles>
        
        <themes:ShadTheme />
        
        <Style Selector="Button.no-effects">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ShadUI's DataGrid template wraps the rows in a ScrollViewer and has no PART_HorizontalScrollbar,
             so the DataGrid can't scroll horizontally. This template uses the DataGrid's own scrollbars,
             laid out like Avalonia's Fluent theme: the rows presenter spans the scrollbar row and column
             so both scrollbars overlay the cells. The DataGrid derives IsVerticalScrollBarOverCells and
             IsHorizontalScrollBarOverCells from these spans; if they don't match the actual layout it
             subtracts unset scrollbar sizes from the cell area and the rows render incorrectly. -->
        <Style Selector="DataGrid.HorizontalScroll">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="DataGridBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,*,Auto"
                              ClipToBounds="True">

                            <Border x:Name="PART_HeaderBackground"
                                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="0,0,0,1"/>

                            <!-- ColumnSpan 2: horizontal scrollbar is treated as overlaying the cells -->
                            <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter"
                                                            Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"/>

                            <!-- RowSpan 2 / ColumnSpan 3: rows extend under both scrollbars -->
                            <DataGridRowsPresenter Name="PART_RowsPresenter"
                                                   Grid.Row="1" Grid.Column="0"
                                                   Grid.RowSpan="2" Grid.ColumnSpan="3"
                                                   ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                                <DataGridRowsPresenter.GestureRecognizers>
                                    <ScrollGestureRecognizer CanHorizontallyScroll="True"
                                                             CanVerticallyScroll="True"
                                                             IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_RowsPresenter}"/>
                                </DataGridRowsPresenter.GestureRecognizers>
                            </DataGridRowsPresenter>

                            <ScrollBar Name="PART_VerticalScrollbar"
                                       Grid.Row="1" Grid.Column="2"
                                       Orientation="Vertical"/>

                            <Grid Grid.Row="2" Grid.Column="1"
                                  ColumnDefinitions="Auto,*">
                                <Rectangle Name="PART_FrozenColumnScrollBarSpacer"/>
                                <ScrollBar Name="PART_HorizontalScrollbar"
                                           Grid.Column="1"
                                           Orientation="Horizontal"/>
                            </Grid>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Same hover animation ShadUI applies to ScrollViewer scrollbars. AllowAutoHide must not be
             set in the template above, template values take precedence over this style. -->
        <Style Selector="DataGrid.HorizontalScroll:pointerover /template/ ScrollBar">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <!-- Smaller text and tighter cells than ShadUI's defaults (14 px, padding 12,8), so more rows and columns
             fit. Cells and rows take the font size from the DataGrid. -->
        <Style Selector="DataGrid.Compact">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="DataGrid.Compact DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="DataGrid.Compact DataGridColumnHeader">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

    </Application.Styles>

</Application>